# Build target: node, vercel, github-pages, or cloudflare-pages.
# Vercel sets its own VERCEL flag; local/self-hosted development can keep node.
DEPLOY_TARGET=node

# Contact form mail delivery.
# Recommended for the current Node/Vercel runtime: direct SMTP.
CONTACT_MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=website@example.com
SMTP_PASSWORD=replace-with-an-app-password

# The From address normally needs to belong to the authenticated SMTP account.
CONTACT_FROM_EMAIL=website@example.com
CONTACT_FROM_NAME=MOCA Website
# Comma-separated addresses are supported.
CONTACT_TO_EMAIL=hello@example.com
CONTACT_SUBJECT_PREFIX=[MOCA Website]
# Required only when a static frontend calls this API from another domain.
# CONTACT_ALLOWED_ORIGINS=https://www.example.com,https://example.com

# Alternative transport: provider-neutral HTTPS webhook.
# Set CONTACT_MAIL_TRANSPORT=webhook and configure both values below.
# CONTACT_MAIL_SERVICE_URL=https://mail-service.example.com/send
# CONTACT_MAIL_SERVICE_TOKEN=replace-with-service-token

# Public site identity
# Set this to the production origin before deploying so canonical and social URLs are absolute.
PUBLIC_SITE_URL=http://localhost:4321

# Static GitHub Pages builds need an external HTTPS contact endpoint.
# Cloudflare Pages and server deployments can keep the same-origin /api/contact default.
# PUBLIC_CONTACT_ENDPOINT=https://contact-api.example.com/api/contact
