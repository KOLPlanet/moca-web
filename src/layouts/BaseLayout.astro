---
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { site } from '../config/site';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string | ImageMetadata;
  article?: {
    publishedTime: string;
    modifiedTime: string;
  };
}

const {
  title = site.name,
  description = site.description,
  canonicalUrl,
  image,
  article,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} · ${site.shortName}`;
const siteOrigin = Astro.site || Astro.url.origin;
const canonical = new URL(canonicalUrl || Astro.url.pathname, siteOrigin).href;
const imageUrl = image
  ? new URL(typeof image === 'string' ? image : image.src, siteOrigin).href
  : undefined;
const googleAnalyticsId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID?.trim();
const googleAnalyticsInit = googleAnalyticsId
  ? `
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', ${JSON.stringify(googleAnalyticsId)});
    `
  : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          <meta property="article:modified_time" content={article.modifiedTime} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    {
      googleAnalyticsId && (
        <>
          <script
            is:inline
            src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
            type="text/partytown"
          />
          <script
            is:inline
            type="text/partytown"
            set:html={googleAnalyticsInit}
          />
        </>
      )
    }
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
