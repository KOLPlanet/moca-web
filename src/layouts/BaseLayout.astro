---
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string | ImageMetadata;
  article?: {
    publishedTime: string;
    modifiedTime: string;
  };
}

const {
  title = site.name,
  description = site.description,
  canonicalUrl,
  image,
  article,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} · ${site.shortName}`;
const siteOrigin = Astro.site || Astro.url.origin;
const canonical = new URL(canonicalUrl || Astro.url.pathname, siteOrigin).href;
const imageUrl = image
  ? new URL(typeof image === 'string' ? image : image.src, siteOrigin).href
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          <meta property="article:modified_time" content={article.modifiedTime} />
        </>
      )
    }
    <link rel="icon" type="image/png" href="/images/moca-logo.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
