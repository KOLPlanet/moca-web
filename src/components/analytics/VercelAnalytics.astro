---
interface Props {
  requiresConsent?: boolean;
}

const { requiresConsent = false } = Astro.props;
---

<script
  is:inline
  type="application/json"
  data-vercel-analytics-bootstrap
  set:html={JSON.stringify({ requiresConsent })}
></script>

<script>
  import { inject, pageview } from '@vercel/analytics';

  const bootstrap = document.querySelector<HTMLScriptElement>(
    '[data-vercel-analytics-bootstrap]',
  );
  const requiresConsent = (() => {
    try {
      return JSON.parse(bootstrap?.textContent || '{}').requiresConsent === true;
    } catch {
      return false;
    }
  })();
  let started = false;

  const getBasePath = () => {
    try {
      return import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_BASEPATH as string | undefined;
    } catch {
      return undefined;
    }
  };

  const getConfigString = () => {
    try {
      return import.meta.env.PUBLIC_VERCEL_OBSERVABILITY_CLIENT_CONFIG as string | undefined;
    } catch {
      return undefined;
    }
  };

  const start = () => {
    if (started) return;
    if (requiresConsent && document.documentElement.dataset.analyticsEnabled !== 'true') return;

    started = true;
    inject(
      {
        framework: 'astro',
        disableAutoTrack: true,
        basePath: getBasePath(),
      },
      getConfigString(),
    );
    pageview({ route: window.location.pathname, path: window.location.pathname });
  };

  start();
  window.addEventListener('moca:analytics-consent', start);
</script>
