---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="form-success-toast" data-form-success-toast hidden>
  <span class="form-success-toast__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
      <path d="m5 12.5 4.25 4.25L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </span>
  <div class="form-success-toast__copy" role="status" aria-live="polite" aria-atomic="true">
    <strong>{title}</strong>
    <span data-form-success-toast-message></span>
  </div>
  <button type="button" aria-label="Dismiss success message" data-form-success-toast-close>
    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
      <path d="m7 7 10 10M17 7 7 17" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
  </button>
</div>

<script>
  const setupFormSuccessToast = (toast: HTMLElement) => {
    if (toast.dataset.formToastReady === 'true') return;
    toast.dataset.formToastReady = 'true';

    const message = toast.querySelector<HTMLElement>('[data-form-success-toast-message]');
    const close = toast.querySelector<HTMLButtonElement>('[data-form-success-toast-close]');
    let dismissTimer: number | undefined;
    let hiddenTimer: number | undefined;

    const hide = () => {
      if (dismissTimer !== undefined) window.clearTimeout(dismissTimer);
      if (hiddenTimer !== undefined) window.clearTimeout(hiddenTimer);
      toast.classList.remove('is-visible');
      hiddenTimer = window.setTimeout(() => {
        if (!toast.classList.contains('is-visible')) toast.hidden = true;
      }, 220);
    };

    toast.addEventListener('moca:form-success', (event) => {
      const detail = (event as CustomEvent<{ message?: string }>).detail;
      if (message) message.textContent = detail?.message || '';
      if (dismissTimer !== undefined) window.clearTimeout(dismissTimer);
      if (hiddenTimer !== undefined) window.clearTimeout(hiddenTimer);
      toast.hidden = false;
      window.requestAnimationFrame(() => toast.classList.add('is-visible'));
      dismissTimer = window.setTimeout(hide, 6000);
    });

    close?.addEventListener('click', hide);
  };

  document
    .querySelectorAll<HTMLElement>('[data-form-success-toast]')
    .forEach(setupFormSuccessToast);
</script>

<style>
  .form-success-toast {
    position: fixed;
    right: clamp(16px, 3vw, 32px);
    bottom: clamp(16px, 3vw, 32px);
    z-index: 90;
    width: min(380px, calc(100vw - 32px));
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    border: 1px solid rgba(16, 24, 16, 0.12);
    border-left: 4px solid var(--moca-green);
    padding: 14px 12px 14px 14px;
    color: var(--ink-900);
    background: rgba(255, 255, 255, 0.98);
    box-shadow: 0 20px 55px rgba(24, 32, 24, 0.2);
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition:
      opacity 180ms ease,
      transform 220ms var(--ease-out);
  }

  .form-success-toast[hidden] {
    display: none;
  }

  .form-success-toast.is-visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .form-success-toast__icon {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #fff;
    background: var(--moca-green);
  }

  .form-success-toast__copy {
    min-width: 0;
    display: grid;
    gap: 2px;
    font-family: var(--font-sans);
    line-height: 1.4;
  }

  .form-success-toast__copy strong {
    color: var(--ink-950);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .form-success-toast__copy span {
    color: var(--ink-500);
    font-size: 0.8rem;
  }

  .form-success-toast button {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border: 0;
    padding: 0;
    color: var(--ink-500);
    background: transparent;
    cursor: pointer;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .form-success-toast button:hover,
  .form-success-toast button:focus-visible {
    color: var(--ink-950);
    background: var(--surface-soft);
  }

  @media (max-width: 520px) {
    .form-success-toast {
      right: 16px;
      bottom: 16px;
      width: calc(100vw - 32px);
    }
  }
</style>
