---
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { id, eyebrow, title, description, align = 'center' } = Astro.props;
---

<header class:list={['section-heading', `section-heading--${align}`]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {description && <p class="section-intro">{description}</p>}
</header>
