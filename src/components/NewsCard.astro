---
import type { NewsItem } from '../data/news';

interface Props {
  item: NewsItem;
  horizontal?: boolean;
}

const { item, horizontal = false } = Astro.props;
const formattedDate = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(new Date(item.date));
---

<article class:list={['news-card', horizontal && 'news-card--horizontal']}>
  <img src={item.image} alt="" width="720" height="306" loading="lazy" />
  <div class="news-card__body">
    <p class="news-meta">{item.category} · {formattedDate}</p>
    <h3>{item.title}</h3>
    <p>{item.excerpt}</p>
  </div>
</article>
