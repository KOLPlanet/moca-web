---
import { site } from '../config/site';

const serviceLinks = [
  { label: 'Core Services', href: '/#services' },
  { label: 'Influencer Marketing', href: '/#services' },
  { label: 'Performance Advertising', href: '/#services' },
  { label: 'Join MOCA', href: '/#join' },
];

const resultLinks = [
  { label: 'Case Studies', href: '/#cases' },
  { label: 'Partner', href: '/#portfolio' },
  { label: 'Latest News', href: '/news' },
  { label: 'Contact Us', href: '/#contact' },
];
---

<footer class="site-footer">
  <div class="footer-shell">
    <div class="footer-grid footer-grid--moca">
      <div class="footer-brand">
        <a class="brand brand--footer" href="/#top" aria-label={`${site.name} home`}>
          <img src="/images/moca-logo.png" alt={site.name} width="137" height="56" />
        </a>
        <p>Performance-driven influencer marketing across emerging markets.</p>
        <ul class="footer-social__links" aria-label="MOCA social media">
          {
            site.socialLinks.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noreferrer" aria-label={`${item.label} — opens in a new tab`}>
                  {item.icon === 'facebook' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103v3.325a26.8 26.8 0 0 0-1.386-.045c-1.92 0-2.728.822-2.728 2.683v1.297h3.919l-.673 3.667h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z" /></svg>}
                  {item.icon === 'linkedin' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286ZM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065Zm1.782 13.019H3.555V9h3.564v11.452ZM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0Z" /></svg>}
                  {item.icon === 'x' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.234 10.162 22.977 0h-2.072l-7.591 8.824L7.251 0H.258l9.168 13.343L.258 24H2.33l8.016-9.318L16.749 24h6.993Zm-2.837 3.299-.929-1.329L3.076 1.56h3.182l5.965 8.532.929 1.329 7.754 11.09h-3.182Z" /></svg>}
                  {item.icon === 'wechat' && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55l-.39 2.145c-.08.31.248.59.522.454l2.003-1.114a10.1 10.1 0 0 0 4.265.255c-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348ZM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.162 1.162 0 1 1-2.324 0c0-.651.52-1.18 1.162-1.18Zm5.813 0c.642 0 1.162.529 1.162 1.18a1.162 1.162 0 1 1-2.324 0c0-.651.52-1.18 1.162-1.18Zm5.34 2.867c-3.674-.106-7.928 2.416-7.06 8.006.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336l2.182 1.008c.274.136.602-.144.522-.454l-.53-1.71C23.024 18.48 24 16.82 24 14.98c0-3.21-2.931-5.837-6.656-6.088-.135-.01-.27-.027-.407-.03Zm-2.53 3.274a.976.976 0 1 1 0 1.965.976.976 0 0 1 0-1.965Zm4.844 0a.976.976 0 1 1 0 1.965.976.976 0 0 1 0-1.965Z" /></svg>}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <nav aria-label="Services">
        <p class="footer-heading">Services</p>
        <ul class="footer-links">
          {serviceLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <nav aria-label="Results">
        <p class="footer-heading">Results</p>
        <ul class="footer-links">
          {resultLinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-app">
        <p class="footer-heading">Get KOLPlanet App</p>
        <p>Manage campaigns anytime, anywhere.<br />For creators only.</p>
        <div class="footer-app__badges" aria-label="Download the KOLPlanet app">
          <span
            class="footer-app-badge footer-app-badge--google"
            role="img"
            tabindex="0"
            aria-label="Google Play app — Coming Soon"
          >
            <img src="/images/home-ui/google-play-badge.png" alt="" width="322" height="96" />
            <span class="footer-app-badge__status" aria-hidden="true">Coming Soon</span>
          </span>
          <span
            class="footer-app-badge footer-app-badge--apple"
            role="img"
            tabindex="0"
            aria-label="App Store app — Coming Soon"
          >
            <img src="/images/home-ui/app-store-badge.png" alt="" width="322" height="96" />
            <span class="footer-app-badge__status" aria-hidden="true">Coming Soon</span>
          </span>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>Copyright © 2025 Moca Technology – <a href={site.legal.icpHref} target="_blank" rel="noreferrer">{site.legal.icpNumber}</a></p>
      <p><a href="https://www.kolplanet.com/" target="_blank" rel="noreferrer">Influencer Marketing Solution Powered by KOLPlanet</a></p>
      <a href={site.legal.privacyPolicyHref}>Term &amp; Policy</a>
    </div>
  </div>
</footer>
