  { name: 'Discord', icon: '/images/social/discord.svg' },
];

const tagSuggestions = [
  'Arts',
  'ASMR',
  'Beauty',
  'Budget',
  'Career',
  'Comedy',
  'Cooking',
  'Education',
  'Entertainment',
  'Family',
  'Fashion',
  'Finance',
  'Fitness',
  'Food',
  'Gadgets',
  'Gaming',
  'Health',
  'Home',
  'Lifestyle',
  'Luxury',
