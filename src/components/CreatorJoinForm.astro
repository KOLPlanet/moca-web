---

<form
  class="creator-join-form"
  data-creator-join-form
  data-tag-suggestions={JSON.stringify(tagSuggestions)}
  data-social-platforms={JSON.stringify(socialPlatforms)}
  data-rate-scope-groups={JSON.stringify(rateScopeGroups)}
  data-languages={JSON.stringify(languages)}
  data-country-currency={JSON.stringify(Object.fromEntries(countries.map((item) => [item.name, item.currency])))}
  data-country-dial={JSON.stringify(Object.fromEntries(countries.map((item) => [item.name, item.dial])))}
  data-country-cities={JSON.stringify(Object.fromEntries(countries.map((item) => [item.name, item.cities])))}
  novalidate
  lang="en"
>
  <div class="creator-join-form__card">
    <section class="creator-join-form__section">
      <h2>About You</h2>
      <label class="creator-join-form__field">
        <span>Account Name <i aria-hidden="true">*</i></span>
        <input name="accountName" type="text" autocomplete="name" maxlength="120" required placeholder="Your creator name" data-required />
      </label>
      <div class="creator-join-form__row">
        <label class="creator-join-form__field">
          <span>Gender</span>
          <select name="gender">
            <option value="">Select</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
            <option value="Other">Other</option>
          </select>
        </label>
        <label class="creator-join-form__field">
          <span>Date of Birth</span>
          <input name="birthday" type="text" inputmode="numeric" maxlength="10" placeholder="YYYY-MM-DD" autocomplete="bday" data-birthday />
        </label>
      </div>
      <div class="creator-join-form__row">
        <label class="creator-join-form__field">
          <span>Country <i aria-hidden="true">*</i></span>
          <select name="country" autocomplete="country-name" required data-country data-required>
            <option value="">Select</option>
            {countries.map((item) => (
              <option value={item.name}>{item.name}</option>
            ))}
          </select>
        </label>
        <label class="creator-join-form__field">
          <span>City</span>
          <div class="creator-join-form__combo" data-combo="city">
            <input
              class="creator-join-form__combo-input"
              type="text"
              maxlength="120"
              placeholder="Search City…"
              autocomplete="off"
              data-combo-input
              aria-autocomplete="list"
              aria-controls="creator-city-options"
            />
            <input type="hidden" name="city" value="" data-combo-value />
            <ul class="creator-join-form__combo-list" id="creator-city-options" role="listbox" hidden data-combo-list></ul>
          </div>
        </label>
      </div>
      <label class="creator-join-form__field">
        <span>Language</span>
        <div class="creator-join-form__combo" data-combo="language">
          <input
            class="creator-join-form__combo-input"
            type="text"
            maxlength="80"
            placeholder="Search Language…"
            autocomplete="off"
            data-combo-input
            aria-autocomplete="list"
            aria-controls="creator-language-options"
          />
          <input type="hidden" name="language" value="" data-combo-value />
          <ul class="creator-join-form__combo-list" id="creator-language-options" role="listbox" hidden data-combo-list></ul>
        </div>
      </label>
    </section>

    <section class="creator-join-form__section">
      <h2>Contact</h2>
      <label class="creator-join-form__field">
        <span>Work Email <i aria-hidden="true">*</i></span>
        <input name="email" type="email" autocomplete="email" maxlength="254" required placeholder="you@email.com" data-required />
      </label>
      <div class="creator-join-form__field">
        <span>WhatsApp</span>
        <div class="creator-join-form__whatsapp">
          <span class="creator-join-form__whatsapp-dial" data-whatsapp-dial>—</span>
          <input type="hidden" name="whatsappDial" value="" data-whatsapp-dial-value />
          <input
            name="whatsappNumber"
            type="tel"
            inputmode="numeric"
            maxlength="20"
            placeholder="Phone Number"
            autocomplete="tel-national"
            data-whatsapp-number
          />
        </div>
      </div>
    </section>
  </div>

  <div class="creator-join-form__card">
    <section class="creator-join-form__section" data-validate-block="socials">
      <h2>Social Accounts <i aria-hidden="true">*</i></h2>
      <p class="creator-join-form__hint">Link or @handle both work.</p>
      <div class="creator-join-form__socials" data-social-list></div>
      <button class="creator-join-form__add" type="button" data-add-social>
        <span aria-hidden="true">+</span> Add Platform
      </button>
      <template data-social-template>
        <div class="creator-join-form__social" data-social-item>
          <div class="creator-join-form__field creator-join-form__field--platform">
            <span class="sr-only">Platform</span>
            <div class="creator-join-form__platform" data-platform-picker>
              <button
                class="creator-join-form__platform-btn is-empty"
                type="button"
                aria-haspopup="listbox"
                aria-expanded="false"
                data-platform-toggle
              >
                <img class="creator-join-form__platform-icon" alt="" hidden data-platform-icon />
                <span data-platform-label>Platform</span>
              </button>
              <input type="hidden" value="" data-social-platform />
              <ul class="creator-join-form__platform-list" role="listbox" hidden data-platform-list></ul>
            </div>
          </div>
          <label class="creator-join-form__field creator-join-form__field--handle">
            <span class="sr-only">Account or Link</span>
            <input type="text" maxlength="300" placeholder="@handle or https://…" data-social-handle />
          </label>
          <button class="creator-join-form__remove" type="button" data-remove-social aria-label="Remove platform">
            ×
          </button>
        </div>
      </template>
    </section>
  </div>

  <div class="creator-join-form__card">
    <section class="creator-join-form__section">
      <h2>Categories</h2>
      <p class="creator-join-form__hint">Choose up to 3.</p>
      <div class="creator-join-form__chips" data-creator-categories>
        {
          categories.map((item) => (
            <label class="creator-join-form__chip">
              <input type="checkbox" name="categories" value={item.label} />
              <span class="creator-join-form__chip-face">
                <span class="creator-join-form__chip-emoji" aria-hidden="true">{item.emoji}</span>
                {item.label}
              </span>
            </label>
          ))
        }
      </div>
    </section>

    <section class="creator-join-form__section">
      <h2>Tags</h2>
      <p class="creator-join-form__hint">Type to search suggestions, or press Enter to add your own. Up to 5.</p>
      <div class="creator-join-form__tags" data-tag-field>
        <div class="creator-join-form__tag-list" data-tag-list></div>
        <div class="creator-join-form__tag-input-wrap">
          <input
            class="creator-join-form__tag-input"
            type="text"
            maxlength="40"
            placeholder="Start typing…"
            autocomplete="off"
            data-tag-input
            aria-autocomplete="list"
            aria-controls="creator-tag-suggestions"
          />
          <ul class="creator-join-form__tag-suggest" id="creator-tag-suggestions" role="listbox" hidden data-tag-suggest></ul>
        </div>
        <input type="hidden" name="tags" value="" data-tag-value />
      </div>
    </section>
  </div>

  <div class="creator-join-form__card creator-join-form__card--fold">
    <details class="creator-join-form__fold">
      <summary>
        <span>Rate Card</span>
      </summary>
      <section class="creator-join-form__section">
        <label class="creator-join-form__field">
          <span>Currency</span>
          <select name="currency" data-currency>
            <option value="">Select</option>
            {currencies.map((item) => (
              <option value={item}>{item}</option>
            ))}
          </select>
        </label>

        <div class="creator-join-form__upload" data-rate-upload>
          <label class="creator-join-form__upload-hit" data-rate-file-hit>
            <input
              class="creator-join-form__upload-input"
              type="file"
              accept="image/*,application/pdf"
              data-rate-file
            />
            <span class="creator-join-form__upload-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
                <path d="M12 16V7m0 0-3.2 3.2M12 7l3.2 3.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M6.5 16.5v1.2c0 .7.6 1.3 1.3 1.3h8.4c.7 0 1.3-.6 1.3-1.3v-1.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
              </svg>
            </span>
            <span>Tap to add a rate card photo</span>
            <small>On your phone: take a photo or pick from albums. PDF also works. Not kept in draft.</small>
          </label>
          <div class="creator-join-form__upload-preview" hidden data-rate-preview>
            <img alt="" data-rate-preview-image hidden />
            <div class="creator-join-form__upload-meta">
              <strong data-rate-preview-name></strong>
              <button class="creator-join-form__add" type="button" data-rate-file-clear>
                Remove
              </button>
            </div>
          </div>
        </div>

        <div class="creator-join-form__scopes">
          <div class="creator-join-form__scopes-head">
            <h2>
              Plan Scope
              <b data-scope-count hidden>0</b>
            </h2>
            <div class="creator-join-form__scope-add" data-scope-picker>
              <button class="creator-join-form__add" type="button" data-add-scope>
                <span aria-hidden="true">+</span> Add Scope
              </button>
              <div class="creator-join-form__scope-menu" hidden data-scope-menu>
                <div class="creator-join-form__scope-groups" data-scope-options></div>
              </div>
            </div>
          </div>
          <p class="creator-join-form__hint" data-scope-empty>Add the deliverables you price. Optional.</p>
          <div class="creator-join-form__scope-list" data-scope-list></div>
          <template data-scope-template>
            <div class="creator-join-form__scope" data-scope-item>
              <div class="creator-join-form__scope-name">
                <strong data-scope-label></strong>
                <input type="hidden" data-scope-name />
              </div>
              <label class="creator-join-form__field creator-join-form__field--price">
                <span class="sr-only">Price</span>
                <span class="creator-join-form__price">
                  <em data-rate-prefix>$</em>
                  <input type="text" maxlength="40" inputmode="decimal" placeholder="Price" data-rate-amount data-scope-price />
                </span>
              </label>
              <button class="creator-join-form__remove" type="button" data-remove-scope aria-label="Remove scope">
                ×
              </button>
            </div>
          </template>
        </div>
      </section>
    </details>
  </div>

  <div class="creator-join-form__card creator-join-form__card--fold">
    <details class="creator-join-form__fold">
      <summary>
        <span>Collaborations & Notes</span>
      </summary>
      <section class="creator-join-form__section">
        <h2>Past Collaborations</h2>
        <p class="creator-join-form__hint">Add brand work if you have it.</p>
        <div class="creator-join-form__collabs" data-creator-collabs></div>
        <button class="creator-join-form__add" type="button" data-add-collab>
          <span aria-hidden="true">+</span> Add Collaboration
        </button>
        <template data-collab-template>
          <div class="creator-join-form__collab" data-collab-item>
            <div class="creator-join-form__collab-fields">
              <label class="creator-join-form__field">
                <span>Brand Name</span>
                <input type="text" maxlength="120" placeholder="e.g. Nike" data-collab-brand />
              </label>
              <label class="creator-join-form__field">
                <span>Post Link</span>
                <input type="text" maxlength="300" placeholder="https://…" data-collab-link />
              </label>
            </div>
            <button class="creator-join-form__remove" type="button" data-remove-collab aria-label="Remove collaboration">
              ×
            </button>
          </div>
        </template>
      </section>

      <section class="creator-join-form__section">
        <h2>Notes</h2>
        <label class="creator-join-form__field">
          <span class="sr-only">Anything else for the team</span>
          <textarea name="notes" rows="3" maxlength="1500" placeholder="Audience size, markets, exclusivity…"></textarea>
        </label>
      </section>
    </details>
  </div>

  <label class="form-honeypot" aria-hidden="true">
    <span>Company website</span>
    <input name="company" type="text" tabindex="-1" autocomplete="off" />
  </label>

  <div class="creator-join-form__footer">
    <p class="creator-join-form__status" role="status" aria-live="polite" data-creator-join-status hidden></p>
    <div class="creator-join-form__actions" data-creator-actions>
      <button class="creator-join-form__draft" type="button" data-creator-draft>
        Save Draft
      </button>
      <button class="creator-join-form__primary" type="submit" data-creator-join-submit>
        Submit
      </button>
    </div>
  </div>
</form>
