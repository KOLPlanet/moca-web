---
import { Image } from 'astro:assets';
import {
  getCollection,
  render,
  type CollectionEntry,
} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../config/site';
import {
  getEstimatedReadingMinutes,
  getTaxonomyCountMap,
  sortTaxonomyItemsByCount,
  sortNewsEntries,
} from '../../lib/news';

export const prerender = true;

export async function getStaticPaths() {
  const posts = sortNewsEntries(
    await getCollection('news', ({ data }) => !data.draft),
  );
  const taxonomyCounts = {
    categories: getTaxonomyCountMap(posts, 'categories'),
    tags: getTaxonomyCountMap(posts, 'tags'),
  };

  return posts.map((post, index) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      taxonomyCounts,
      newerPost: posts[index - 1],
      olderPost: posts[index + 1],
    },
  }));
}

interface Props {
  post: CollectionEntry<'news'>;
  taxonomyCounts: {
    categories: Record<string, number>;
    tags: Record<string, number>;
  };
  newerPost?: CollectionEntry<'news'>;
  olderPost?: CollectionEntry<'news'>;
}

const { post, taxonomyCounts, newerPost, olderPost } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const publishedAt = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(data.publishedAt);
const updatedAt = new Intl.DateTimeFormat('en', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(data.updatedAt);
const readingMinutes = getEstimatedReadingMinutes(post);
const orderedCategories = sortTaxonomyItemsByCount(
  data.categories,
  taxonomyCounts.categories,
);
const orderedTags = sortTaxonomyItemsByCount(data.tags, taxonomyCounts.tags);

const siteOrigin = Astro.site || Astro.url.origin;
const pageUrl = new URL(`/news/${data.slug}`, siteOrigin).href;
const orgId = new URL('/#organization', siteOrigin).href;
const linkedIn = site.socialLinks.find((link) => link.icon === 'linkedin');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': pageUrl,
      url: pageUrl,
      name: data.seoTitle || data.title,
      description: data.description,
      inLanguage: data.language,
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['.article-summary', '.article-takeaways'],
      },
    },
    {
      '@type': 'Article',
      '@id': `${pageUrl}#article`,
      headline: data.title,
      description: data.description,
      abstract: data.summary,
      image: new URL(data.cover.src.src, siteOrigin).href,
      datePublished: data.publishedAt.toISOString(),
      dateModified: data.updatedAt.toISOString(),
      inLanguage: data.language,
      author:
        data.author.type === 'Organization'
          ? { '@id': orgId }
          : { '@type': 'Person', name: data.author.name },
      publisher: { '@id': orgId },
      mainEntityOfPage: { '@id': pageUrl },
      articleSection: data.categories.map((item) => item.name),
      keywords: data.tags.map((item) => item.name).join(', '),
      ...(data.citations.length > 0 && {
        citation: data.citations.map((item) => ({
          '@type': 'CreativeWork',
          name: item.name,
          url: item.url,
          ...(item.publisher && {
            publisher: { '@type': 'Organization', name: item.publisher },
          }),
          ...(item.publishedAt && {
            datePublished: item.publishedAt.toISOString(),
          }),
        })),
      }),
    },
    ...(data.faq.length > 0
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${pageUrl}#faq`,
            mainEntity: data.faq.map((item) => ({
              '@type': 'Question',
              name: item.question,
              acceptedAnswer: { '@type': 'Answer', text: item.answer },
            })),
          },
        ]
      : []),
    {
      '@type': 'Organization',
      '@id': orgId,
      name: site.name,
      url: new URL('/', siteOrigin).href,
      logo: new URL('/images/moca-logo.svg', siteOrigin).href,
      foundingDate: '2012',
      email: site.contact.cooperationEmail,
      ...(linkedIn && { sameAs: [linkedIn.href] }),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', siteOrigin).href },
        { '@type': 'ListItem', position: 2, name: 'News', item: new URL('/news', siteOrigin).href },
        { '@type': 'ListItem', position: 3, name: data.title, item: pageUrl },
      ],
    },
  ],
};
// Escape "<" so article text can never close the script tag early.
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<BaseLayout
  title={data.seoTitle || data.title}
  description={data.description}
  canonicalUrl={`/news/${data.slug}`}
  image={data.cover.src}
  imageAlt={data.cover.alt}
  article={{
    publishedTime: data.publishedAt.toISOString(),
    modifiedTime: data.updatedAt.toISOString(),
    author: data.author.name,
  }}
>
  <script type="application/ld+json" slot="head" is:inline set:html={jsonLdHtml} />
  <div
    class="reading-progress"
    role="progressbar"
    aria-label="Article reading progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    data-reading-progress
  >
    <span></span>
  </div>

  <article class="article-page" data-reading-article>
    <header class="article-header article-shell">
      <nav class="article-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/news">News</a>
      </nav>
      <div class="article-header__meta">
        <div class="article-header__categories">
          {
            data.categories.map((category) => (
              <a href={`/news/category/${category.slug}`}>{category.name}</a>
            ))
          }
        </div>
        <div class="article-header__details">
          <time datetime={data.publishedAt.toISOString()}>{publishedAt}</time>
          <span aria-hidden="true">·</span>
          <span>{readingMinutes} min read</span>
        </div>
      </div>
      <h1>{data.title}</h1>
      <p class="article-summary">{data.summary}</p>
      <p class="article-byline">By {data.author.name}</p>
    </header>

    <div class="article-cover article-shell">
      <Image
        src={data.cover.src}
        alt={data.cover.alt}
        widths={[720, 1080, 1280]}
        sizes="(max-width: 1180px) calc(100vw - 40px), 1120px"
        loading="eager"
      />
    </div>

    <div class="article-layout article-shell">
      <div class="article-content">
        {
          data.keyTakeaways.length > 0 && (
            <aside class="article-takeaways">
              <p class="eyebrow">Key takeaways</p>
              <ul>
                {data.keyTakeaways.map((takeaway) => <li>{takeaway}</li>)}
              </ul>
            </aside>
          )
        }
        <Content />
      </div>

      <aside class="article-aside">
        <p class="eyebrow">Article details</p>
        <dl>
          <div>
            <dt>Published</dt>
            <dd>{publishedAt}</dd>
          </div>
          <div>
            <dt>Reading time</dt>
            <dd>{readingMinutes} minutes</dd>
          </div>
          {
            data.updatedAt.valueOf() !== data.publishedAt.valueOf() && (
              <div>
                <dt>Updated</dt>
                <dd>{updatedAt}</dd>
              </div>
            )
          }
          <div>
            <dt>Categories</dt>
            <dd class="article-aside__links">
              {
                data.categories.map((category) => (
                  <a href={`/news/category/${category.slug}`}>{category.name}</a>
                ))
              }
            </dd>
          </div>
        </dl>
      </aside>
    </div>

    <footer class="article-footer article-shell">
      <div class="article-taxonomy">
        <section aria-labelledby="article-categories-heading">
          <p class="eyebrow">Filed under</p>
          <h2 id="article-categories-heading">Categories</h2>
          <div class="taxonomy-chips">
            {
              orderedCategories.map((category) => (
                <a href={`/news/category/${category.slug}`}>
                  <span>{category.name}</span>
                  <strong>{taxonomyCounts.categories[category.slug] || 0}</strong>
                </a>
              ))
            }
          </div>
        </section>

        {
          data.tags.length > 0 && (
            <section aria-labelledby="article-tags-heading">
              <p class="eyebrow">Explore more</p>
              <h2 id="article-tags-heading">Tags</h2>
              <div class="taxonomy-chips taxonomy-chips--tags">
                {orderedTags.map((tag) => (
                  <a href={`/news/tag/${tag.slug}`}>
                    <span>{tag.name}</span>
                    <strong>{taxonomyCounts.tags[tag.slug] || 0}</strong>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </div>

      <nav class="article-navigation" aria-label="More news articles">
        {
          newerPost ? (
            <a href={`/news/${newerPost.data.slug}`}>
              <span class="article-navigation__label">Newer article</span>
              <strong>{newerPost.data.title}</strong>
            </a>
          ) : (
            <span />
          )
        }
        {
          olderPost && (
            <a class="article-navigation__next" href={`/news/${olderPost.data.slug}`}>
              <span class="article-navigation__label">Older article</span>
              <strong>{olderPost.data.title}</strong>
            </a>
          )
        }
      </nav>
    </footer>
  </article>
</BaseLayout>

<script>
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  const article = document.querySelector<HTMLElement>('[data-reading-article]');
  let frame: number | undefined;

  const updateReadingProgress = () => {
    if (!progress || !article) return;

    const articleTop = article.getBoundingClientRect().top + window.scrollY;
    const articleEnd = articleTop + article.offsetHeight - window.innerHeight;
    const distance = Math.max(1, articleEnd - articleTop);
    const ratio = Math.min(
      1,
      Math.max(0, (window.scrollY - articleTop) / distance),
    );

    progress.style.setProperty('--reading-progress', `${ratio}`);
    progress.setAttribute('aria-valuenow', `${Math.round(ratio * 100)}`);
    frame = undefined;
  };

  const requestReadingProgressUpdate = () => {
    if (frame !== undefined) return;
    frame = window.requestAnimationFrame(updateReadingProgress);
  };

  updateReadingProgress();
  window.addEventListener('scroll', requestReadingProgressUpdate, {
    passive: true,
  });
  window.addEventListener('resize', requestReadingProgressUpdate);
</script>
