---
import { getCollection } from 'astro:content';
import NewsArchive from '../../../components/NewsArchive.astro';
import {
  filterNewsByTaxonomy,
  getTaxonomyLabel,
  getTaxonomySummaries,
  paginateNews,
  sortNewsEntries,
} from '../../../lib/news';

export const prerender = true;

export async function getStaticPaths() {
  const allEntries = sortNewsEntries(
    await getCollection('news', ({ data }) => !data.draft),
  );
  const categories = getTaxonomySummaries(allEntries, 'categories');

  return categories.flatMap((category) => {
    const matchingEntries = filterNewsByTaxonomy(
      allEntries,
      'categories',
      category.slug,
    );
    const totalPages = paginateNews(matchingEntries, 1).totalPages;

    return Array.from({ length: totalPages }, (_, index) => {
      const currentPage = index + 1;
      return {
        params: {
          path:
            currentPage === 1
              ? category.slug
              : `${category.slug}/page/${currentPage}`,
        },
        props: {
          allEntries,
          matchingEntries,
          currentPage,
          slug: category.slug,
        },
      };
    });
  });
}

const {
  allEntries,
  matchingEntries,
  currentPage,
  slug,
} = Astro.props;
const page = paginateNews(matchingEntries, currentPage);
const label = getTaxonomyLabel(allEntries, 'categories', slug) || slug;
---

<NewsArchive
  title={label}
  eyebrow="News category"
  description={`Articles filed under ${label}.`}
  entries={page.entries}
  allEntries={allEntries}
  currentPage={page.currentPage}
  totalPages={page.totalPages}
  totalEntries={page.totalEntries}
  basePath={`/news/category/${slug}`}
  activeFilter={{ kind: 'category', label, slug }}
/>
