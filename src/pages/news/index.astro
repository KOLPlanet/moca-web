---
import { getCollection } from 'astro:content';
import NewsArchive from '../../components/NewsArchive.astro';
import { paginateNews, sortNewsEntries } from '../../lib/news';

export const prerender = true;

const allEntries = sortNewsEntries(
  await getCollection('news', ({ data }) => !data.draft),
);
const page = paginateNews(allEntries, 1);
---

<NewsArchive
  title="News & Insights"
  eyebrow="MOCA intelligence"
  description="Influencer marketing, creator campaigns, CTV, e-commerce, and platform policy across Southeast Asia and India."
  intro="MOCA News & Insights covers how brands grow across Southeast Asia and India. Articles look at influencer marketing and creator campaigns, connected TV and OTT advertising, e-commerce and content commerce, mobile and gaming growth, and the platform policy changes that decide what works on TikTok, YouTube, Instagram, and marketplaces. Browse by category to find the market, channel, or topic you are planning for."
  entries={page.entries}
  allEntries={allEntries}
  currentPage={page.currentPage}
  totalPages={page.totalPages}
  totalEntries={page.totalEntries}
  basePath="/news"
/>
