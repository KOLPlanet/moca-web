---

<BaseLayout
  title="MOCA Technology"
  description="Global influencer marketing and performance advertising, delivered with local expertise."
>
  <section id="top" class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero__media" aria-hidden="true">
      <img
        class="home-hero__image"
        src="/images/home-figma/hero.jpg"
        alt=""
        width="3840"
        height="2160"
        fetchpriority="high"
      />
      <div class="home-hero__shade"></div>
    </div>
    <div class="home-hero__content">
      <div class="home-hero__copy">
        <h1 id="home-hero-title">Local Heart, Global Scale</h1>
        <p class="home-hero__lede">
          Empowering brands to capture mindshare with right-fit influencers while
          driving positive ROI through high-precision performance advertising.
        </p>
        <a
          class="home-hero__cta"
          href="https://www.instagram.com/p/DTxtwRJjNyT/"
          target="_blank"
          rel="noreferrer"
          data-hero-cta
        >
          <span class="home-hero__cta-frost" aria-hidden="true" data-hero-cta-frost></span>
          <span class="home-hero__cta-veil" aria-hidden="true"></span>
          <span class="home-hero__cta-label">Watch Now</span>
          <img src="/images/home-ui/hero-play.svg" alt="" width="26" height="26" />
        </a>
      </div>
    </div>
  </section>

  <section id="services" class="home-section home-services" aria-labelledby="services-title">
    <div class="home-container">
      <header class="home-section-heading">
        <h2 id="services-title">Core Services</h2>
        <p>Combining performance-driven advertising with authentic influence.</p>
      </header>

      <div class="service-story">
        <div class="service-story__copy">
          <p class="home-kicker">Brand awareness</p>
          <h3>Influencer Marketing</h3>
          <p>
            We specialize in building brand authority and trust through
            meaningful creator partnerships.
          </p>
          <ul>
            <li><strong>One-stop influencer solution</strong> from strategy to delivery.</li>
            <li>Creator selection, content direction, and measurable reporting.</li>
            <li>Local storytelling with the scale to move across markets.</li>
          </ul>
        </div>
        <figure class="service-story__visual">
          <img
            src="/images/home-figma/service-influencer.jpg"
            alt="MOCA influencer marketing character and content creation setup"
            width="1592"
            height="1177"
            loading="lazy"
          />
        </figure>
      </div>

      <div class="service-story service-story--reverse">
        <div class="service-story__copy">
          <p class="home-kicker">User acquisition</p>
          <h3>Performance Advertising</h3>
          <p>
            High-velocity growth across OEM partnerships and major advertising
            platforms, connecting transparent data with efficient scale.
          </p>
          <ul>
            <li>Campaign planning and delivery across priority markets.</li>
            <li>Optimized for CPI, CPA, and ROAS goals.</li>
            <li>Scalable acquisition across high-growth markets.</li>
          </ul>
        </div>
        <figure class="service-story__visual">
          <img
            src="/images/home-figma/service-performance.jpg"
            alt="MOCA performance advertising character aiming at a growth target"
            width="1499"
            height="1049"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <section id="about" class="home-about" aria-labelledby="about-title">
    <img
      class="home-about__background"
      src="/images/home-figma/about-bg.jpg"
      alt=""
      width="2400"
      height="1832"
      loading="lazy"
    />
    <div class="home-container home-about__content">
      <header class="sr-only">
        <h2 id="about-title">About MOCA</h2>
        <p>Your local partner for global ambition.</p>
      </header>

      <div class="markets" aria-labelledby="markets-title">
        <h3 id="markets-title">Key Markets</h3>
        <div class="markets__grid">
          {
            markets.map((market) => (
              <figure class="market-card">
                <img src={market.image} alt="" width="420" height="250" loading="lazy" />
                <figcaption>{market.name}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="cases" class="home-section home-cases" aria-labelledby="cases-title">
    <div class="home-container home-container--wide">
      <header class="home-section-heading">
        <h2 id="cases-title">Real Voices, Proven Results</h2>
        <p>Campaigns shaped by local culture and built to perform.</p>
      </header>
      <div class="cases-carousel">
        <button
          class="cases-carousel__button cases-carousel__button--previous"
          type="button"
          aria-label="Show previous cases"
          data-cases-previous
          disabled
        >
          <img src="/images/home-ui/carousel-arrow.svg" alt="" width="20" height="20" />
        </button>
        <div class="cases-scroller" data-cases-scroller>
          {
            cases.map((item) => (
              <figure class="case-poster" data-case-card data-case-href={item.href}>
                <button
                  class="case-poster__trigger"
                  type="button"
                  aria-label={`Play ${item.alt}`}
                  data-case-video-trigger
                >
                  <img
                    class="case-poster__cover"
                    src={item.poster}
                    alt={item.alt}
                    width="540"
                    height="960"
                    loading="lazy"
                    data-case-cover
                  />
                  <span class="media-play" aria-hidden="true">
                    <img src="/images/home-ui/media-play.svg" alt="" width="52" height="52" />
                  </span>
                </button>
                <video
                  class="case-poster__video"
                  data-case-video
                  data-src={item.video}
                  poster={item.poster}
                  playsinline
                  preload="none"
                  controls
                  hidden
                ></video>
              </figure>
            ))
          }
        </div>
        <button
          class="cases-carousel__button cases-carousel__button--next"
          type="button"
          aria-label="Show next cases"
          data-cases-next
        >
          <img src="/images/home-ui/carousel-arrow.svg" alt="" width="20" height="20" />
        </button>
      </div>
    </div>
  </section>

  <section id="portfolio" class="home-portfolio" aria-labelledby="portfolio-title">
    <img
      class="home-portfolio__background"
      src="/images/home-figma/portfolio-bg.jpg"
      alt=""
      width="1672"
      height="941"
      loading="lazy"
    />
    <div class="home-portfolio__shade"></div>
    <div class="home-portfolio__content">
      <header class="home-section-heading home-section-heading--light home-container">
        <h2 id="portfolio-title">Our Portfolio of Success</h2>
        <p>Brands and platforms connected through ideas that move markets.</p>
      </header>
      <p class="sr-only">The brand showcase moves automatically and pauses when hovered.</p>
      <div class="brand-marquees">
        {
          brandRows.map((row, rowIndex) => (
            <div class:list={['brand-marquee', rowIndex === 1 && 'brand-marquee--reverse']}>
              <div class="brand-marquee__track">
                {[false, true].map((duplicate) => (
                  <ul class="brand-marquee__group" aria-hidden={duplicate ? 'true' : undefined}>
                    {row.map((brand) => (
                      <li class="brand-tile">
                        <img src={brand.logo} alt={duplicate ? '' : brand.name} loading="lazy" />
                      </li>
                    ))}
                  </ul>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="insights" class="home-section home-insights" aria-labelledby="insights-title">
    <div class="home-container home-container--wide">
      <header class="home-section-heading">
        <h2 id="insights-title">The Pulse of MOCA</h2>
        <p>Industry deep-dives, event highlights, and company milestones.</p>
      </header>
      <div class="insight-carousel">
        <button
          class="insight-carousel__button insight-carousel__button--previous"
          type="button"
          aria-label="Show previous articles"
          data-insight-previous
          disabled
        >
          <img src="/images/home-ui/carousel-arrow.svg" alt="" width="20" height="20" />
        </button>
        <div class="insight-scroller" data-insight-scroller>
          {
            newsItems.map((entry, index) => {
              const formattedDate = new Intl.DateTimeFormat('en', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              }).format(entry.data.publishedAt);
              const readingMinutes = getEstimatedReadingMinutes(entry);
              return (
                <article class="home-news-card">
                  <div class="home-news-card__body">
                    <div class="home-news-card__meta">
                      <span>{entry.data.categories[0]?.name || 'MOCA Insight'}</span>
                      <span aria-hidden="true">·</span>
                      <time datetime={entry.data.publishedAt.toISOString()}>{formattedDate}</time>
                      <span aria-hidden="true">·</span>
                      <span>{readingMinutes} min read</span>
                    </div>
                    <h3><a href={`/news/${entry.data.slug}`}>{entry.data.seoTitle || entry.data.title}</a></h3>
                    <p>{entry.data.description}</p>
                  </div>
                  <a class="home-news-card__media" href={`/news/${entry.data.slug}`} aria-label={`Read ${entry.data.title}`}>
                    <Image
                      src={entry.data.cover.src}
                      alt={entry.data.cover.alt}
                      widths={[320, 480, 640]}
                      sizes="(max-width: 700px) 82vw, 384px"
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                  </a>
                </article>
              );
            })
          }
          <a class="home-news-more-card" href="/news" aria-label="View more articles">
            <span class="home-button home-insights__more">View more</span>
          </a>
        </div>
        <button
          class="insight-carousel__button insight-carousel__button--next"
          type="button"
          aria-label="Show next articles"
          data-insight-next
        >
          <img src="/images/home-ui/carousel-arrow.svg" alt="" width="20" height="20" />
        </button>
      </div>
    </div>
  </section>

  <section id="contact" class="home-contact" aria-labelledby="contact-title">
    <img
      class="home-contact__background"
      src="/images/home-figma/contact.jpg"
      alt="MOCA character delivering a message across a desert road"
      width="1672"
      height="941"
      loading="lazy"
    />
    <div class="home-contact__shade"></div>
    <div class="home-container home-contact__inner">
      <form class="home-contact-form" action="/api/contact" method="post" data-contact-form>
        <header class="home-section-heading home-section-heading--light">
          <h2 id="contact-title">Contact Us</h2>
          <p>Let’s start a conversation about your next market.</p>
        </header>
        <label>
          <span>Your name</span>
          <input name="name" type="text" autocomplete="name" required />
        </label>
        <label>
          <span>Your email</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          <span>Subject</span>
          <input name="subject" type="text" required />
        </label>
        <label>
          <span>Content</span>
          <textarea name="message" rows="4" required></textarea>
        </label>
        <label class="form-honeypot" aria-hidden="true">
          <span>Company website</span>
          <input name="company" type="text" tabindex="-1" autocomplete="off" />
        </label>
        <button class="home-button home-button--solid" type="submit">Send</button>
        <p class="form-status" role="status" aria-live="polite"></p>
        <p class="home-contact-form__privacy">
          By sending this form you agree to our <a href="/privacy-policy">Privacy Policy</a>.
        </p>
      </form>
    </div>
  </section>

  <section id="join" class="home-join" aria-labelledby="join-title">
    <img
      class="home-join__background"
      src="/images/home-figma/join.jpg"
      alt=""
      width="2306"
      height="791"
      loading="lazy"
    />
    <div class="home-join__shade"></div>
    <div class="home-container home-join__content">
      <header class="home-section-heading home-section-heading--light">
        <h2 id="join-title">Join MOCA</h2>
        <p>Choose your role and start growing with us.</p>
      </header>
      <div class="join-grid">
        <article class="join-card">
          <h3>For Publishers</h3>
          <p>Monetize your traffic through high-quality campaigns and global advertisers.</p>
          <a class="join-card__button" href={publisherLink.href} target="_blank" rel="noreferrer">
            Join as publisher
          </a>
        </article>
        <article class="join-card join-card--brand">
          <div>
            <h3>For Brands</h3>
            <p>
              Secure your market position with 100% verified influence and ROI-driven UA.
            </p>
            <a class="join-card__button join-card__button--outline" href={advertiserLink.href} target="_blank" rel="noreferrer">
              Work with us
            </a>
          </div>
          <img src="/images/home-figma/join-brand.png" alt="" width="190" height="154" loading="lazy" />
        </article>
        <article class="join-card">
          <h3>For Creators</h3>
          <p>Collaborate with top brands and turn your content into real income.</p>
          <a class="join-card__button" href="#contact">Join as creator</a>
        </article>
      </div>
    </div>
  </section>

  <section id="life" class="home-life" aria-labelledby="life-title">
    <div class="home-container">
      <header class="home-section-heading home-section-heading--light">
        <h2 id="life-title">Life at MOCA</h2>
        <p>A global team sharing ideas, markets, and moments.</p>
      </header>
    </div>
    <div class="home-container home-container--wide">
      <div class="life-grid">
        {
          lifeAtMoca.map((item) => {
            const media = (
              <>
                <img src={item.image} alt={`Life at MOCA — ${item.label}`} width="1200" height="1800" loading="lazy" />
                <span class="media-play" aria-hidden="true">
                  <img src="/images/home-ui/media-play.svg" alt="" width="52" height="52" />
                </span>
                <span class="life-card__label">{item.label}</span>
              </>
            );

            return item.href ? (
              <a
                class="life-card"
                href={item.href}
                target="_blank"
                rel="noreferrer"
                aria-label={`${item.label} — opens in a new tab`}
              >
                {media}
              </a>
            ) : (
              <figure class="life-card">
                {media}
              </figure>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const hero = document.querySelector<HTMLElement>('.home-hero');
  const heroCta = document.querySelector<HTMLElement>('[data-hero-cta]');
  const heroCtaFrost = document.querySelector<HTMLElement>('[data-hero-cta-frost]');

  const syncHeroCtaFrost = () => {
    if (!hero || !heroCta || !heroCtaFrost) return;

    const heroRect = hero.getBoundingClientRect();
    const ctaRect = heroCta.getBoundingClientRect();
    const pad = 28;

    heroCtaFrost.style.width = `${heroRect.width + pad * 2}px`;
    heroCtaFrost.style.height = `${heroRect.height + pad * 2}px`;
    heroCtaFrost.style.left = `${heroRect.left - ctaRect.left - pad}px`;
    heroCtaFrost.style.top = `${heroRect.top - ctaRect.top - pad}px`;
    heroCtaFrost.style.backgroundSize = `${heroRect.width}px ${heroRect.height}px`;
    heroCtaFrost.style.backgroundPosition = `${pad}px ${pad}px`;
  };

  syncHeroCtaFrost();
  window.addEventListener('resize', syncHeroCtaFrost, { passive: true });
  window.addEventListener('scroll', syncHeroCtaFrost, { passive: true });

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('.form-status');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !submit) return;

    submit.disabled = true;
    status.textContent = 'Sending…';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const result = await response.json();

      if (!response.ok) throw new Error(result.message || 'Unable to send your message.');

      form.reset();
      status.textContent = result.message;
    } catch (error) {
      status.textContent =
        error instanceof Error ? error.message : 'Unable to send your message.';
    } finally {
      submit.disabled = false;
    }
  });

  const insightScroller = document.querySelector<HTMLElement>('[data-insight-scroller]');
  const previousButton = document.querySelector<HTMLButtonElement>('[data-insight-previous]');
  const nextButton = document.querySelector<HTMLButtonElement>('[data-insight-next]');

  const updateInsightControls = () => {
    if (!insightScroller || !previousButton || !nextButton) return;
    const maxScroll = insightScroller.scrollWidth - insightScroller.clientWidth;
    const atStart = maxScroll <= 2 || insightScroller.scrollLeft <= 2;
    const atEnd = maxScroll <= 2 || insightScroller.scrollLeft >= maxScroll - 2;
    previousButton.hidden = atStart;
    nextButton.hidden = atEnd;
    previousButton.disabled = atStart;
    nextButton.disabled = atEnd;
  };

  const moveInsights = (direction: -1 | 1) => {
    if (!insightScroller) return;
    const firstCard = insightScroller.querySelector<HTMLElement>('.home-news-card');
    const styles = window.getComputedStyle(insightScroller);
    const gap = Number.parseFloat(styles.columnGap || styles.gap) || 0;
    const distance = (firstCard?.getBoundingClientRect().width || insightScroller.clientWidth) + gap;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    insightScroller.scrollBy({
      left: distance * direction,
      behavior: reducedMotion ? 'auto' : 'smooth',
    });
  };

  previousButton?.addEventListener('click', () => moveInsights(-1));
  nextButton?.addEventListener('click', () => moveInsights(1));
  insightScroller?.addEventListener('scroll', updateInsightControls, { passive: true });
  window.addEventListener('resize', updateInsightControls);
  updateInsightControls();

  const casesScroller = document.querySelector<HTMLElement>('[data-cases-scroller]');
  const casesPrevious = document.querySelector<HTMLButtonElement>('[data-cases-previous]');
  const casesNext = document.querySelector<HTMLButtonElement>('[data-cases-next]');

  const updateCasesControls = () => {
    if (!casesScroller || !casesPrevious || !casesNext) return;
    const maxScroll = casesScroller.scrollWidth - casesScroller.clientWidth;
    const atStart = maxScroll <= 2 || casesScroller.scrollLeft <= 2;
    const atEnd = maxScroll <= 2 || casesScroller.scrollLeft >= maxScroll - 2;
    casesPrevious.hidden = atStart;
    casesNext.hidden = atEnd;
    casesPrevious.disabled = atStart;
    casesNext.disabled = atEnd;
  };

  const moveCases = (direction: -1 | 1) => {
    if (!casesScroller) return;
    const firstCard = casesScroller.querySelector<HTMLElement>('.case-poster');
    const styles = window.getComputedStyle(casesScroller);
    const gap = Number.parseFloat(styles.columnGap || styles.gap) || 0;
    const distance = (firstCard?.getBoundingClientRect().width || casesScroller.clientWidth) + gap;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    casesScroller.scrollBy({
      left: distance * direction,
      behavior: reducedMotion ? 'auto' : 'smooth',
    });
  };

  casesPrevious?.addEventListener('click', () => moveCases(-1));
  casesNext?.addEventListener('click', () => moveCases(1));
  casesScroller?.addEventListener('scroll', updateCasesControls, { passive: true });
  window.addEventListener('resize', updateCasesControls);
  updateCasesControls();

  const pauseOtherCaseVideos = (active?: HTMLVideoElement) => {
    casesScroller?.querySelectorAll<HTMLVideoElement>('[data-case-video]').forEach((video) => {
      if (video === active) return;
      video.pause();
      if (!video.hidden) {
        video.hidden = true;
        video
          .closest<HTMLElement>('[data-case-card]')
          ?.querySelector<HTMLButtonElement>('[data-case-video-trigger]')
          ?.removeAttribute('hidden');
      }
    });
  };

  casesScroller?.querySelectorAll<HTMLButtonElement>('[data-case-video-trigger]').forEach((trigger) => {
    trigger.addEventListener('click', async () => {
      const card = trigger.closest<HTMLElement>('[data-case-card]');
      const video = card?.querySelector<HTMLVideoElement>('[data-case-video]');
      if (!card || !video) return;

      const src = video.dataset.src;
      if (!src) return;

      pauseOtherCaseVideos(video);

      if (!video.getAttribute('src')) {
        video.src = src;
      }

      trigger.hidden = true;
      video.hidden = false;

      try {
        await video.play();
      } catch {
        // Videos may still be pending — fall back to the Instagram source post.
        video.hidden = true;
        trigger.hidden = false;
        const href = card.dataset.caseHref;
        if (href) window.open(href, '_blank', 'noopener,noreferrer');
      }
    });
  });

  casesScroller?.querySelectorAll<HTMLVideoElement>('[data-case-video]').forEach((video) => {
    video.addEventListener('ended', () => {
      video.hidden = true;
      video
        .closest('[data-case-card]')
        ?.querySelector<HTMLButtonElement>('[data-case-video-trigger]')
        ?.removeAttribute('hidden');
    });
  });
</script>
