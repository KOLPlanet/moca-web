---

<BaseLayout
  title={site.homeTitle}
  description={site.description}
>
  <section id="top" class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero__media" aria-hidden="true">
      <img
        class="home-hero__image"
        src="/images/home-figma/hero.jpg"
        alt=""
        width="3840"
        height="2160"
        fetchpriority="high"
      />
      <div class="home-hero__shade"></div>
    </div>
    <div class="home-hero__content">
      <div class="home-hero__copy">
        <h1 id="home-hero-title">Local Depth, Brand Altitude</h1>
        <p class="home-hero__lede">
          Root your growth in data-driven performance advertising and elevate market
          presence with authentic influencer strategies.
        </p>
        <a
          class="home-hero__cta"
          href="https://www.instagram.com/p/DTxtwRJjNyT/"
          target="_blank"
          rel="noreferrer"
          data-hero-cta
          data-analytics-cta="explore_story"
          data-analytics-location="hero"
          data-analytics-audience="general"
        >
          <span class="home-hero__cta-frost" aria-hidden="true" data-hero-cta-frost></span>
          <span class="home-hero__cta-veil" aria-hidden="true"></span>
          <span class="home-hero__cta-label">Explore Our Story</span>
          <img src="/images/home-ui/hero-play.svg" alt="" width="26" height="26" />
        </a>
      </div>
    </div>
  </section>

  <section id="services" class="home-section home-services" aria-labelledby="services-title">
    <div class="home-container">
      <header class="home-section-heading">
        <h2 id="services-title">Core Services</h2>
        <p>Combining performance-driven advertising <br class="break-mobile" />with authentic influence.</p>
      </header>

      <div class="service-story">
        <div class="service-story__copy">
          <p class="home-kicker">Brand Awareness &amp; Growth</p>
          <h3>Influencer Marketing</h3>
          <p>
            Transforming authentic content into premium brand authority.
          </p>
          <ul>
            <li>
              <strong>Full-Funnel Strategy</strong>
              Integrated solutions spanning campaign planning, influencer activation,
              paid media, and social management.
            </li>
            <li>
              <strong>Creator Partnerships</strong>
              Precise influencer selection, tailored content direction, and data-backed
              performance tracking.
            </li>
            <li>
              <strong>Omnichannel Execution</strong>
              Seamless delivery across digital platforms, localized PR, and experiential
              offline events.
            </li>
          </ul>
        </div>
        <figure class="service-story__visual">
          <img
            src="/images/home-figma/service-influencer.jpg"
            alt="MOCA influencer marketing character and content creation setup"
            width="1592"
            height="1177"
            loading="lazy"
          />
        </figure>
      </div>

      <div class="service-story service-story--reverse">
        <div class="service-story__copy">
          <p class="home-kicker">User Acquisition</p>
          <h3>Performance Advertising</h3>
          <p>
            Penetrating local markets with precision-tuned user acquisition.
          </p>
          <ul>
            <li>
              <strong>Rapid Scale via Direct Traffic</strong>
              Fast-track growth with high-intent, fraud-free traffic directly from OEMs
              and premium developers.
            </li>
            <li>
              <strong>In-House Platform</strong>
              Powered by proprietary algorithms precision-tuned to hit your CPI, CPA,
              and ROAS targets.
            </li>
            <li>
              <strong>Seamless MMP Integration</strong>
              Native connection with major MMPs (AppsFlyer, Adjust, Kochava, Singular)
              for real-time attribution.
            </li>
          </ul>
        </div>
        <figure class="service-story__visual">
          <img
            src="/images/home-figma/service-performance.jpg"
            alt="MOCA performance advertising character aiming at a growth target"
            width="1499"
            height="1049"
            loading="lazy"
          />
        </figure>
      </div>
    </div>
  </section>

  <section id="about" class="home-about" aria-labelledby="about-title">
    <img
      class="home-about__background"
      src="/images/home-figma/about-bg.jpg"
      alt=""
      width="2400"
      height="1832"
      loading="lazy"
    />
    <div class="home-about__shade" aria-hidden="true"></div>
    <div class="home-container home-about__content">
      <div class="about-panel">
        <header class="about-panel__header">
          <h2 id="about-title">About MOCA</h2>
          <p>Deeply Rooted, Highly Elevated.</p>
        </header>

        <div class="about-panel__body">
          <div class="about-panel__story">
            <h3>Founded in 2012</h3>
            <p>
              <strong>MOCA</strong> is a pioneer in digital marketing for the world’s
              most vibrant emerging markets.
            </p>
            <p>
              We specialize in helping global brands build long-term authority through
              authentic influencer collaborations and achieve rapid growth through
              data-driven performance marketing.
            </p>
          </div>

          <div class="about-panel__presence" aria-labelledby="presence-title">
            <h3 id="presence-title">Global Presence</h3>
            <ul class="about-presence-list">
              {
                offices.map((office) => (
                  <li>
                    <img src={office.flag} alt="" width="30" height="21" loading="lazy" />
                    <span>{office.name}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <div class="markets" aria-labelledby="markets-title">
        <h3 id="markets-title">Key Markets</h3>
        <div class="markets__grid">
          {
            markets.map((market) => (
              <figure class="market-card">
                <img src={market.image} alt="" width="420" height="250" loading="lazy" />
                <figcaption>{market.name}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="cases" class="home-section home-cases" aria-labelledby="cases-title">
    <div class="home-container home-container--wide">
      <header class="home-section-heading">
        <h2 id="cases-title">Real Voices, Proven Results</h2>
        <p>Deep Local Resonance. High-Altitude ROI.</p>
      </header>
      <div class="cases-carousel">
        <button
          class="cases-carousel__button cases-carousel__button--previous"
          type="button"
          aria-label="Show previous cases"
          data-cases-previous
          disabled
        >
          <img src="/images/home-ui/carousel-arrow.svg" alt="" width="20" height="20" />
        </button>
        <div class="cases-scroller" data-cases-scroller>
          {
            cases.map((item) => (
              <figure
                class="case-poster"
                data-case-card
                data-case-href={item.href}
                data-case-id={item.id}
                data-case-name={item.name}
              >
                <button
                  class="case-poster__trigger"
                  type="button"
                  aria-label={`Play ${item.alt}`}
                  data-case-video-trigger
                >
                  <img
                    class="case-poster__cover"
                    src={item.poster}
                    alt={item.alt}
                    width="540"
                    height="960"
                    loading="lazy"
                    data-case-cover
                  />
                  <span class="media-play" aria-hidden="true">
                    <img src="/images/home-ui/media-play.svg" alt="" width="52" height="52" />
                  </span>
                </button>
                <video
                  class="case-poster__video"
                  data-case-video
                  data-src={item.video}
                  poster={item.poster}
                  playsinline
                  preload="none"
                  controls
                  hidden
                ></video>
              </figure>
            ))
          }
        </div>
        <button
          class="cases-carousel__button cases-carousel__button--next"
          type="button"
          aria-label="Show next cases"
          data-cases-next
        >
          <img src="/images/home-ui/carousel-arrow.svg" alt="" width="20" height="20" />
        </button>
      </div>
    </div>
  </section>

  <section id="kolplanet" class="home-kolplanet" aria-label="KOLPlanet demo">
    <button
      class="kolplanet-demo__trigger"
      type="button"
      aria-label="Play KOLPlanet demo video"
      data-kolplanet-play
    >
      <img
        class="kolplanet-demo__poster"
        src="/images/kolplanet/demo-poster.jpg"
        alt="KOLPlanet platform demo preview"
        width="3500"
        height="835"
        loading="lazy"
      />
      <span class="media-play" aria-hidden="true">
        <img src="/images/home-ui/media-play.svg" alt="" width="52" height="52" />
      </span>
    </button>

    <dialog class="kolplanet-modal" data-kolplanet-modal aria-label="KOLPlanet demo video">
      <div class="kolplanet-modal__panel">
        <button class="kolplanet-modal__close" type="button" aria-label="Close demo video" data-kolplanet-close>
          Close
        </button>
        <div class="kolplanet-modal__frame">
          <iframe
            data-kolplanet-iframe
            title="KOLPlanet demo video"
            src="about:blank"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </dialog>
  </section>

  <section id="portfolio" class="home-portfolio" aria-labelledby="portfolio-title">
    <img
      class="home-portfolio__background"
      src="/images/home-figma/portfolio-bg.jpg"
      alt=""
      width="1672"
      height="941"
      loading="lazy"
    />
    <div class="home-portfolio__shade"></div>
    <div class="home-portfolio__content">
      <header class="home-section-heading home-section-heading--light home-container">
        <h2 id="portfolio-title">Our Portfolio of Success</h2>
        <p>
          Brands and platforms connected through <br class="break-mobile" />ideas that
          move markets.
        </p>
      </header>
      <p class="sr-only">The brand showcase moves automatically and pauses when hovered.</p>
      <div class="brand-marquees">
        {
          brandRows.map((row, rowIndex) => (
            <div class:list={['brand-marquee', rowIndex === 1 && 'brand-marquee--reverse']}>
              <div class="brand-marquee__track">
                {[false, true].map((duplicate) => (
                  <ul class="brand-marquee__group" aria-hidden={duplicate ? 'true' : undefined}>
                    {row.map((brand) => (
                      <li class:list={['brand-tile', brand.fit && `brand-tile--${brand.fit}`]}>
                        <img src={brand.logo} alt={duplicate ? '' : brand.name} loading="lazy" />
                      </li>
                    ))}
                  </ul>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="insights" class="home-section home-insights" aria-labelledby="insights-title" hidden>
    <div class="home-container home-container--wide">
      <header class="home-section-heading">
        <h2 id="insights-title">The Pulse of MOCA</h2>
        <p>Industry deep-dives, event highlights, and company milestones.</p>
      </header>
      <div class="insight-carousel">
        <button
          class="insight-carousel__button insight-carousel__button--previous"
          type="button"
          aria-label="Show previous articles"
          data-insight-previous
          disabled
        >
          <img src="/images/home-ui/carousel-arrow.svg" alt="" width="20" height="20" />
        </button>
        <div class="insight-scroller" data-insight-scroller>
          {
            newsItems.map((entry, index) => {
              const formattedDate = new Intl.DateTimeFormat('en', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
              }).format(entry.data.publishedAt);
              const readingMinutes = getEstimatedReadingMinutes(entry);
              return (
                <article class="home-news-card">
                  <div class="home-news-card__body">
                    <div class="home-news-card__meta">
                      <span class="home-news-card__category">
                        {entry.data.categories[0]?.name || 'MOCA Insight'}
                      </span>
                      <span class="home-news-card__meta-dot" aria-hidden="true">·</span>
                      <time datetime={entry.data.publishedAt.toISOString()}>{formattedDate}</time>
                      <span class="home-news-card__meta-dot" aria-hidden="true">·</span>
                      <span>{readingMinutes} min read</span>
                    </div>
                    <h3><a href={`/news/${entry.data.slug}`}>{entry.data.seoTitle || entry.data.title}</a></h3>
                    <p>{entry.data.description}</p>
                  </div>
                  <a class="home-news-card__media" href={`/news/${entry.data.slug}`} aria-label={`Read ${entry.data.title}`}>
                    <Image
                      src={entry.data.cover.src}
                      alt={entry.data.cover.alt}
                      widths={[320, 480, 640]}
                      sizes="(max-width: 700px) 82vw, 384px"
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                  </a>
                </article>
              );
            })
          }
          <a class="home-news-more-card" href="/news" aria-label="View more articles">
            <span class="home-button home-insights__more">View more</span>
          </a>
        </div>
        <button
          class="insight-carousel__button insight-carousel__button--next"
          type="button"
          aria-label="Show next articles"
          data-insight-next
        >
          <img src="/images/home-ui/carousel-arrow.svg" alt="" width="20" height="20" />
        </button>
      </div>
    </div>
  </section>

  <section id="life" class="home-life" aria-labelledby="life-title">
    <div class="home-container">
      <header class="home-section-heading">
        <h2 id="life-title">Life at MOCA</h2>
        <p>A global team sharing ideas, markets, <br class="break-mobile" />and moments.</p>
      </header>
    </div>
    <div class="home-container home-container--wide">
      <div class="life-grid">
        {
          lifeAtMoca.map((item) => {
            const media = (
              <>
                <img src={item.image} alt={`Life at MOCA — ${item.label}`} width="1200" height="1800" loading="lazy" />
                {item.href ? (
                  <span class="media-play" aria-hidden="true">
                    <img src="/images/home-ui/media-play.svg" alt="" width="52" height="52" />
                  </span>
                ) : null}
                <span class="life-card__label">{item.label}</span>
              </>
            );

            return item.href ? (
              <a
                class="life-card"
                href={item.href}
                target="_blank"
                rel="noreferrer"
                aria-label={`${item.label} — opens in a new tab`}
              >
                {media}
              </a>
            ) : (
              <figure class="life-card">
                {media}
              </figure>
            );
          })
        }
      </div>
    </div>
  </section>

  <section id="contact" class="home-contact" aria-labelledby="contact-title">
    <img
      class="home-contact__background"
      src="/images/home-figma/contact.jpg"
      alt="MOCA character delivering a message across a desert road"
      width="1672"
      height="941"
      loading="lazy"
    />
    <div class="home-contact__shade"></div>
    <div class="home-container home-contact__inner">
      <form class="home-contact-form" action={contactEndpoint} method="post" data-contact-form>
        <header class="home-section-heading home-section-heading--light">
          <h2 id="contact-title">Contact Us</h2>
          <p>Let’s start a conversation about your next market.</p>
        </header>
        <label>
          <span>Your name</span>
          <input name="name" type="text" autocomplete="name" maxlength="120" required />
        </label>
        <label>
          <span>Your email</span>
          <input name="email" type="email" autocomplete="email" maxlength="254" required />
        </label>
        <label>
          <span>Subject</span>
          <input name="subject" type="text" maxlength="180" required />
        </label>
        <label>
          <span>Content</span>
          <textarea name="message" rows="3" maxlength="5000" required></textarea>
        </label>
        <label class="form-honeypot" aria-hidden="true">
          <span>Company website</span>
          <input name="company" type="text" tabindex="-1" autocomplete="off" />
        </label>
        <button class="home-button home-button--solid" type="submit">Send</button>
        <div class="home-contact-quick" aria-label="Direct email">
          <a
            class="home-contact-quick__button"
            href={`mailto:${site.contact.cooperationEmail}`}
            title={site.contact.cooperationEmail}
            data-analytics-cta="contact_cooperation"
            data-analytics-location="contact"
            data-analytics-audience="brand"
          >
            <span class="home-contact-quick__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                <path
                  d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"
                ></path>
              </svg>
            </span>
            <span class="home-contact-quick__copy">
              <span class="home-contact-quick__label">For Cooperation</span>
              <span class="home-contact-quick__email">{site.contact.cooperationEmail}</span>
            </span>
          </a>
          <a
            class="home-contact-quick__button"
            href={`mailto:${site.contact.careersEmail}`}
            title={site.contact.careersEmail}
            data-analytics-cta="contact_careers"
            data-analytics-location="contact"
            data-analytics-audience="career"
          >
            <span class="home-contact-quick__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
                <path
                  d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"
                ></path>
              </svg>
            </span>
            <span class="home-contact-quick__copy">
              <span class="home-contact-quick__label">For Job</span>
              <span class="home-contact-quick__email">{site.contact.careersEmail}</span>
            </span>
          </a>
        </div>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section id="join" class="home-join" aria-labelledby="join-title">
    <img
      class="home-join__background"
      src="/images/home-figma/join.jpg"
      alt=""
      width="2306"
      height="791"
      loading="lazy"
    />
    <div class="home-join__shade"></div>
    <div class="home-container home-join__content">
      <header class="home-section-heading home-section-heading--light">
        <h2 id="join-title">Join MOCA</h2>
        <p>Choose your role and start growing with us.</p>
      </header>
      <div class="join-grid">
        <article class="join-card">
          <h3>For Publishers</h3>
          <p>Monetize your traffic through high-quality campaigns and global advertisers.</p>
          <a
            class="join-card__button"
            href={publisherLink.href}
            target="_blank"
            rel="noreferrer"
            data-analytics-cta="join_publisher"
            data-analytics-location="join"
            data-analytics-audience="publisher"
          >
            Join as publisher
          </a>
        </article>
        <article class="join-card join-card--brand">
          <div>
            <h3>For Brands</h3>
            <p>
              Secure your market position with 100% verified influence and ROI-driven UA.
            </p>
            <a
              class="join-card__button join-card__button--outline"
              href={advertiserLink.href}
              target="_blank"
              rel="noreferrer"
              data-analytics-cta="work_with_us"
              data-analytics-location="join"
              data-analytics-audience="advertiser"
            >
              Work with us
            </a>
          </div>
          <img src="/images/home-figma/join-brand.png" alt="" width="190" height="154" loading="lazy" />
        </article>
        <article class="join-card">
          <h3>For Creators</h3>
          <p>Collaborate with top brands and turn your content into real income.</p>
          <a
            class="join-card__button"
            href="/join/creator"
            target="_blank"
            rel="noreferrer"
            data-analytics-cta="join_creator"
            data-analytics-location="join"
            data-analytics-audience="creator"
          >
            Join as creator
          </a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { trackAnalyticsEvent } from '../lib/analytics';

  const sectionIds = [
    'top',
    'services',
    'about',
    'cases',
    'kolplanet',
    'portfolio',
    'life',
    'contact',
    'join',
  ] as const;
  const sectionPositions = new Map<string, number>(
    sectionIds.map((sectionId, index) => [sectionId, index + 1]),
  );
  const sectionEntries = new Map<HTMLElement, IntersectionObserverEntry>();
  const sectionTimers = new Map<HTMLElement, number>();
  const trackedSections = new Set<string>();
  let sectionObserver: IntersectionObserver | undefined;

  const hasMeaningfulSectionVisibility = (entry: IntersectionObserverEntry) => {
    const referenceHeight = Math.min(entry.boundingClientRect.height, window.innerHeight);
    return (
      entry.isIntersecting &&
      referenceHeight > 0 &&
      entry.intersectionRect.height / referenceHeight >= 0.5
    );
  };

  const clearSectionTimer = (section: HTMLElement) => {
    const timer = sectionTimers.get(section);
    if (timer === undefined) return;
    window.clearTimeout(timer);
    sectionTimers.delete(section);
  };

  const updateSectionView = (section: HTMLElement) => {
    const entry = sectionEntries.get(section);
    const sectionId = section.id;
    const canTrack =
      document.visibilityState === 'visible' &&
      Boolean(entry && hasMeaningfulSectionVisibility(entry));

    if (!canTrack) {
      clearSectionTimer(section);
      return;
    }

    if (trackedSections.has(sectionId) || sectionTimers.has(section)) return;

    const timer = window.setTimeout(() => {
      sectionTimers.delete(section);
      const latestEntry = sectionEntries.get(section);
      if (
        document.visibilityState !== 'visible' ||
        !latestEntry ||
        !hasMeaningfulSectionVisibility(latestEntry)
      ) {
        return;
      }

      trackAnalyticsEvent('section_view', {
        section_id: sectionId,
        section_position: sectionPositions.get(sectionId),
      });
      trackedSections.add(sectionId);
      sectionObserver?.unobserve(section);
      sectionEntries.delete(section);
    }, 1_000);

    sectionTimers.set(section, timer);
  };

  if ('IntersectionObserver' in window) {
    sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const section = entry.target as HTMLElement;
          sectionEntries.set(section, entry);
          updateSectionView(section);
        });
      },
      { threshold: [0, 0.25, 0.5, 0.75, 1] },
    );

    sectionIds.forEach((sectionId) => {
      const section = document.getElementById(sectionId);
      if (section && !section.hidden) sectionObserver?.observe(section);
    });

    document.addEventListener('visibilitychange', () => {
      sectionEntries.forEach((_entry, section) => updateSectionView(section));
    });
  }

  document.querySelectorAll<HTMLElement>('[data-analytics-cta]').forEach((cta) => {
    cta.addEventListener('click', () => {
      trackAnalyticsEvent('cta_click', {
        cta_id: cta.dataset.analyticsCta,
        cta_location: cta.dataset.analyticsLocation,
        audience: cta.dataset.analyticsAudience,
      });
    });
  });

  const hero = document.querySelector<HTMLElement>('.home-hero');
  const heroCta = document.querySelector<HTMLElement>('[data-hero-cta]');
  const heroCtaFrost = document.querySelector<HTMLElement>('[data-hero-cta-frost]');

  const syncHeroCtaFrost = () => {
    if (!hero || !heroCta || !heroCtaFrost) return;

    const heroRect = hero.getBoundingClientRect();
    const ctaRect = heroCta.getBoundingClientRect();
    const pad = 28;

    heroCtaFrost.style.width = `${heroRect.width + pad * 2}px`;
    heroCtaFrost.style.height = `${heroRect.height + pad * 2}px`;
    heroCtaFrost.style.left = `${heroRect.left - ctaRect.left - pad}px`;
    heroCtaFrost.style.top = `${heroRect.top - ctaRect.top - pad}px`;
    heroCtaFrost.style.backgroundSize = `${heroRect.width}px ${heroRect.height}px`;
    heroCtaFrost.style.backgroundPosition = `${pad}px ${pad}px`;
  };

  syncHeroCtaFrost();
  window.addEventListener('resize', syncHeroCtaFrost, { passive: true });
  window.addEventListener('scroll', syncHeroCtaFrost, { passive: true });

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('.form-status');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !submit) return;

    submit.disabled = true;
    status.textContent = 'Sending…';

    let errorType = 'network_error';
    let httpStatus = 0;

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      httpStatus = response.status;

      let result: { accepted?: unknown; message?: unknown };
      try {
        result = await response.json();
      } catch {
        errorType = 'invalid_response';
        throw new Error('Unable to read the server response.');
      }

      const responseMessage =
        typeof result.message === 'string'
          ? result.message
          : 'Unable to send your message.';

      if (!response.ok) {
        errorType = 'http_error';
        throw new Error(responseMessage);
      }

      if (result.accepted === true) {
        trackAnalyticsEvent('generate_lead', {
          form_id: 'contact_form',
          lead_type: 'business_inquiry',
        });
      }

      form.reset();
      status.textContent = responseMessage;
    } catch (error) {
      trackAnalyticsEvent('contact_form_error', {
        form_id: 'contact_form',
        error_type: errorType,
        http_status: httpStatus,
      });
      status.textContent =
        error instanceof Error ? error.message : 'Unable to send your message.';
    } finally {
      submit.disabled = false;
    }
  });

  const insightScroller = document.querySelector<HTMLElement>('[data-insight-scroller]');
  const previousButton = document.querySelector<HTMLButtonElement>('[data-insight-previous]');
  const nextButton = document.querySelector<HTMLButtonElement>('[data-insight-next]');

  const updateInsightControls = () => {
    if (!insightScroller || !previousButton || !nextButton) return;
    const maxScroll = insightScroller.scrollWidth - insightScroller.clientWidth;
    const atStart = maxScroll <= 2 || insightScroller.scrollLeft <= 2;
    const atEnd = maxScroll <= 2 || insightScroller.scrollLeft >= maxScroll - 2;
    previousButton.hidden = atStart;
    nextButton.hidden = atEnd;
    previousButton.disabled = atStart;
    nextButton.disabled = atEnd;
  };

  const moveInsights = (direction: -1 | 1) => {
    if (!insightScroller) return;
    const firstCard = insightScroller.querySelector<HTMLElement>('.home-news-card');
    const styles = window.getComputedStyle(insightScroller);
    const gap = Number.parseFloat(styles.columnGap || styles.gap) || 0;
    const distance = (firstCard?.getBoundingClientRect().width || insightScroller.clientWidth) + gap;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    insightScroller.scrollBy({
      left: distance * direction,
      behavior: reducedMotion ? 'auto' : 'smooth',
    });
  };

  previousButton?.addEventListener('click', () => moveInsights(-1));
  nextButton?.addEventListener('click', () => moveInsights(1));
  insightScroller?.addEventListener('scroll', updateInsightControls, { passive: true });
  window.addEventListener('resize', updateInsightControls);
  updateInsightControls();

  const casesScroller = document.querySelector<HTMLElement>('[data-cases-scroller]');
  const casesPrevious = document.querySelector<HTMLButtonElement>('[data-cases-previous]');
  const casesNext = document.querySelector<HTMLButtonElement>('[data-cases-next]');

  const updateCasesControls = () => {
    if (!casesScroller || !casesPrevious || !casesNext) return;
    const maxScroll = casesScroller.scrollWidth - casesScroller.clientWidth;
    const atStart = maxScroll <= 2 || casesScroller.scrollLeft <= 2;
    const atEnd = maxScroll <= 2 || casesScroller.scrollLeft >= maxScroll - 2;
    casesPrevious.hidden = atStart;
    casesNext.hidden = atEnd;
    casesPrevious.disabled = atStart;
    casesNext.disabled = atEnd;
  };

  const moveCases = (direction: -1 | 1) => {
    if (!casesScroller) return;
    const firstCard = casesScroller.querySelector<HTMLElement>('.case-poster');
    const styles = window.getComputedStyle(casesScroller);
    const gap = Number.parseFloat(styles.columnGap || styles.gap) || 0;
    const distance = (firstCard?.getBoundingClientRect().width || casesScroller.clientWidth) + gap;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    casesScroller.scrollBy({
      left: distance * direction,
      behavior: reducedMotion ? 'auto' : 'smooth',
    });
  };

  casesPrevious?.addEventListener('click', () => moveCases(-1));
  casesNext?.addEventListener('click', () => moveCases(1));
  casesScroller?.addEventListener('scroll', updateCasesControls, { passive: true });
  window.addEventListener('resize', updateCasesControls);
  updateCasesControls();

  const pauseOtherCaseVideos = (active?: HTMLVideoElement) => {
    casesScroller?.querySelectorAll<HTMLVideoElement>('[data-case-video]').forEach((video) => {
      if (video === active) return;
      video.pause();
      if (!video.hidden) {
        video.hidden = true;
        video
          .closest<HTMLElement>('[data-case-card]')
          ?.querySelector<HTMLButtonElement>('[data-case-video-trigger]')
          ?.removeAttribute('hidden');
      }
    });
  };

  casesScroller?.querySelectorAll<HTMLButtonElement>('[data-case-video-trigger]').forEach((trigger) => {
    trigger.addEventListener('click', async () => {
      const card = trigger.closest<HTMLElement>('[data-case-card]');
      const video = card?.querySelector<HTMLVideoElement>('[data-case-video]');
      if (!card || !video) return;

      const src = video.dataset.src;
      if (!src) return;

      pauseOtherCaseVideos(video);

      if (!video.getAttribute('src')) {
        video.src = src;
      }

      trigger.hidden = true;
      video.hidden = false;

      try {
        await video.play();
      } catch {
        // Videos may still be pending — fall back to the Instagram source post.
        video.hidden = true;
        trigger.hidden = false;
        const href = card.dataset.caseHref;
        if (href) window.open(href, '_blank', 'noopener,noreferrer');
      }
    });
  });

  casesScroller?.querySelectorAll<HTMLVideoElement>('[data-case-video]').forEach((video) => {
    const trackedProgress = new Set<number>();
    let started = false;
    let completed = false;

    const videoParameters = (videoPercent: number) => {
      const card = video.closest<HTMLElement>('[data-case-card]');
      return {
        video_id: card?.dataset.caseId,
        video_title: card?.dataset.caseName,
        video_provider: 'self_hosted',
        video_url: video.dataset.src,
        video_current_time: Math.round(video.currentTime),
        video_duration: Number.isFinite(video.duration) ? Math.round(video.duration) : undefined,
        video_percent: videoPercent,
        visible: !video.hidden,
      };
    };

    video.addEventListener('play', () => {
      if (started) return;
      started = true;
      trackAnalyticsEvent('video_start', videoParameters(0));
    });

    video.addEventListener('timeupdate', () => {
      if (!Number.isFinite(video.duration) || video.duration <= 0) return;
      const playedPercent = (video.currentTime / video.duration) * 100;

      [25, 50, 75].forEach((milestone) => {
        if (playedPercent < milestone || trackedProgress.has(milestone)) return;
        trackedProgress.add(milestone);
        trackAnalyticsEvent('video_progress', videoParameters(milestone));
      });
    });

    video.addEventListener('ended', () => {
      if (!completed) {
        completed = true;
        trackAnalyticsEvent('video_complete', videoParameters(100));
      }
      video.hidden = true;
      video
        .closest('[data-case-card]')
        ?.querySelector<HTMLButtonElement>('[data-case-video-trigger]')
        ?.removeAttribute('hidden');
    });
  });

  const kolplanetModal = document.querySelector<HTMLDialogElement>('[data-kolplanet-modal]');
  const kolplanetPlay = document.querySelector<HTMLButtonElement>('[data-kolplanet-play]');
  const kolplanetClose = document.querySelector<HTMLButtonElement>('[data-kolplanet-close]');
  const kolplanetIframe = document.querySelector<HTMLIFrameElement>('[data-kolplanet-iframe]');
  const kolplanetDemoSrc = `https://www.youtube.com/embed/OFltA1Ng9P8?autoplay=1&rel=0&enablejsapi=1&origin=${encodeURIComponent(window.location.origin)}`;

  const closeKolplanetDemo = () => {
    if (!kolplanetModal) return;
    if (kolplanetIframe) kolplanetIframe.src = 'about:blank';
    kolplanetModal.close();
  };

  kolplanetPlay?.addEventListener('click', () => {
    if (!kolplanetModal || !kolplanetIframe) return;
    kolplanetIframe.src = kolplanetDemoSrc;
    if (typeof kolplanetModal.showModal === 'function') {
      kolplanetModal.showModal();
    } else {
      kolplanetModal.setAttribute('open', '');
    }
  });

  kolplanetClose?.addEventListener('click', closeKolplanetDemo);
  kolplanetModal?.addEventListener('click', (event) => {
    if (event.target === kolplanetModal) closeKolplanetDemo();
  });
  kolplanetModal?.addEventListener('close', () => {
    if (kolplanetIframe) kolplanetIframe.src = 'about:blank';
  });
  window.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeKolplanetDemo();
  });
</script>
