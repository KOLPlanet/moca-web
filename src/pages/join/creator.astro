---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CreatorJoinForm from '../../components/CreatorJoinForm.astro';
import FormSuccessToast from '../../components/FormSuccessToast.astro';
import { site } from '../../config/site';
import '../../styles/home.css';

export const prerender = true;

const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '/api/contact';
---

<BaseLayout
  title="Join as Creator"
  description="Apply to join KOLPlanet as a creator. Share your profile, social accounts, and categories to get matched with brand campaigns in India and Southeast Asia."
  robots="noindex, follow"
  bare
>
  <div class="creator-join-page">
    <header class="creator-join-page__top">
      <a class="creator-join-page__brand" href="/" aria-label={`${site.name} home`}>
        <img src="/images/moca-logo.svg" alt={site.name} width="120" height="48" />
      </a>
    </header>

    <div class="creator-join-page__shell">
      <header class="creator-join-page__intro">
        <h1>Join as Creator</h1>
        <p>Apply to join KOLPlanet and get matched with brand campaigns in your market.</p>
      </header>

      <CreatorJoinForm />
    </div>
    <FormSuccessToast title="Application sent" />
  </div>
</BaseLayout>

<script define:vars={{ contactEndpoint }}>
  const form = document.querySelector('[data-creator-join-form]');
  const status = document.querySelector('[data-creator-join-status]');
  const submit = document.querySelector('[data-creator-join-submit]');
  const successToast = document.querySelector('[data-form-success-toast]');
  const draftBtn = document.querySelector('[data-creator-draft]');
  const categories = document.querySelector('[data-creator-categories]');
  const socialList = document.querySelector('[data-social-list]');
  const addSocial = document.querySelector('[data-add-social]');
  const socialTemplate = document.querySelector('[data-social-template]');
  const collabs = document.querySelector('[data-creator-collabs]');
  const addCollab = document.querySelector('[data-add-collab]');
  const collabTemplate = document.querySelector('[data-collab-template]');
  const scopeList = document.querySelector('[data-scope-list]');
  const scopeTemplate = document.querySelector('[data-scope-template]');
  const addScope = document.querySelector('[data-add-scope]');
  const scopeMenu = document.querySelector('[data-scope-menu]');
  const scopeOptions = document.querySelector('[data-scope-options]');
  const scopeCount = document.querySelector('[data-scope-count]');
  const scopeEmpty = document.querySelector('[data-scope-empty]');
  const tagField = document.querySelector('[data-tag-field]');
  const tagList = document.querySelector('[data-tag-list]');
  const tagInput = document.querySelector('[data-tag-input]');
  const tagSuggest = document.querySelector('[data-tag-suggest]');
  const tagValue = document.querySelector('[data-tag-value]');
  const rateFile = document.querySelector('[data-rate-file]');
  const rateFileHit = document.querySelector('[data-rate-file-hit]');
  const ratePreview = document.querySelector('[data-rate-preview]');
  const ratePreviewImage = document.querySelector('[data-rate-preview-image]');
  const ratePreviewName = document.querySelector('[data-rate-preview-name]');
  const rateFileClear = document.querySelector('[data-rate-file-clear]');
  let rateCardFile = null;
  let ratePreviewUrl = '';
  const DRAFT_KEY = 'moca-creator-join-draft';
  const submitLabel = submit?.textContent?.trim() || 'Submit';

  const maxTags = 5;
  const maxSocials = 6;
  const selectedTags = [];

  const platforms = (() => {
    try {
      const raw = JSON.parse(form?.getAttribute('data-social-platforms') || '[]');
      return raw.map((item) => (typeof item === 'string' ? { name: item, icon: '' } : item));
    } catch {
      return [];
    }
  })();

  const platformByName = (name) => platforms.find((item) => item.name === name);

  const normalizePlatform = (name) => {
    if (name === 'X / Twitter') return 'X';
    if (name === 'Other') return '';
    return platformByName(name) ? name : '';
  };

  const allTagSuggestions = (() => {
    try {
      return JSON.parse(form?.getAttribute('data-tag-suggestions') || '[]');
    } catch {
      return [];
    }
  })();

  const rateScopeGroups = (() => {
    try {
      const raw = JSON.parse(form?.getAttribute('data-rate-scope-groups') || '[]');
      if (Array.isArray(raw) && raw[0]?.items) return raw;
      if (Array.isArray(raw)) return [{ label: 'Standard Deliverables', items: raw }];
      return [];
    } catch {
      return [];
    }
  })();

  const countryCurrency = (() => {
    try {
      return JSON.parse(form?.getAttribute('data-country-currency') || '{}');
    } catch {
      return {};
    }
  })();

  const countryDial = (() => {
    try {
      return JSON.parse(form?.getAttribute('data-country-dial') || '{}');
    } catch {
      return {};
    }
  })();

  const countryCities = (() => {
    try {
      return JSON.parse(form?.getAttribute('data-country-cities') || '{}');
    } catch {
      return {};
    }
  })();

  const languageOptions = (() => {
    try {
      return JSON.parse(form?.getAttribute('data-languages') || '[]');
    } catch {
      return [];
    }
  })();

  const countrySelect = document.querySelector('[data-country]');
  const currencySelect = document.querySelector('[data-currency]');
  const whatsappDial = document.querySelector('[data-whatsapp-dial]');
  const whatsappDialValue = document.querySelector('[data-whatsapp-dial-value]');
  const whatsappNumber = document.querySelector('[data-whatsapp-number]');
  let currencyTouched = false;

  const setStatus = (message = '', tone = 'info') => {
    if (!status) return;
    status.textContent = message;
    status.hidden = !message;
    status.dataset.tone = tone;
  };

  const setCreatorSubmitting = (isSubmitting, label = 'Submitting…') => {
    if (!submit) return;
    submit.disabled = isSubmitting;
    submit.setAttribute('aria-busy', String(isSubmitting));
    submit.textContent = isSubmitting ? label : submitLabel;
  };

  const showCreatorSuccess = (message) => {
    successToast?.dispatchEvent(
      new CustomEvent('moca:form-success', { detail: { message } }),
    );
  };

  const clearInvalid = () => {
    form?.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
  };

  const markInvalid = (el) => {
    if (!(el instanceof Element)) return;
    el.classList.add('is-invalid');
    el.closest('.creator-join-form__field')?.classList.add('is-invalid');
  };

  const focusInvalid = (el) => {
    if (!(el instanceof HTMLElement)) return;
    const target =
      el instanceof HTMLInputElement && el.matches('[data-social-platform]')
        ? el.closest('[data-platform-picker]')?.querySelector('[data-platform-toggle]') ?? el
        : el;
    if (!(target instanceof HTMLElement)) return;
    target.focus({ preventScroll: true });
    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  const isValidEmail = (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

  const isValidBirthday = (value) => {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(value)) return false;
    const [year, month, day] = value.split('-').map(Number);
    const date = new Date(Date.UTC(year, month - 1, day));
    return (
      date.getUTCFullYear() === year &&
      date.getUTCMonth() === month - 1 &&
      date.getUTCDate() === day &&
      year >= 1950 &&
      year <= new Date().getFullYear() - 13
    );
  };

  const formatBirthdayInput = (input) => {
    const digits = input.value.replace(/\D/g, '').slice(0, 8);
    const parts = [];
    if (digits.length > 0) parts.push(digits.slice(0, 4));
    if (digits.length > 4) parts.push(digits.slice(4, 6));
    if (digits.length > 6) parts.push(digits.slice(6, 8));
    input.value = parts.join('-');
  };

  const currencySymbols = {
    USD: '$',
    IDR: 'Rp',
    MYR: 'RM',
    SGD: 'S$',
    THB: '฿',
    VND: '₫',
    PHP: '₱',
    INR: '₹',
    JPY: '¥',
    KRW: '₩',
    CNY: '¥',
    HKD: 'HK$',
    TWD: 'NT$',
    GBP: '£',
    AUD: 'A$',
    EUR: '€',
  };

  const updateRatePlaceholders = () => {
    const code = currencySelect instanceof HTMLSelectElement ? currencySelect.value : '';
    const symbol = currencySymbols[code] || '$';
    form?.querySelectorAll('[data-rate-prefix]').forEach((el) => {
      el.textContent = symbol;
    });
  };

  const syncCurrencyFromCountry = (force = false) => {
    if (!(currencySelect instanceof HTMLSelectElement) || !(countrySelect instanceof HTMLSelectElement)) return;
    if (currencyTouched && !force) return;
    currencySelect.value = countryCurrency[countrySelect.value] || '';
    updateRatePlaceholders();
  };

  const syncWhatsappDial = () => {
    if (!(countrySelect instanceof HTMLSelectElement)) return;
    const dial = countrySelect.value ? countryDial[countrySelect.value] || '+' : '—';
    if (whatsappDial) whatsappDial.textContent = dial;
    if (whatsappDialValue instanceof HTMLInputElement) {
      whatsappDialValue.value = dial === '—' ? '' : dial;
    }
  };

  const setupCombo = (root, getOptions, { allowCustom = false } = {}) => {
    if (!(root instanceof HTMLElement)) return null;
    const input = root.querySelector('[data-combo-input]');
    const valueInput = root.querySelector('[data-combo-value]');
    const list = root.querySelector('[data-combo-list]');
    if (!(input instanceof HTMLInputElement) || !(valueInput instanceof HTMLInputElement) || !(list instanceof HTMLElement)) {
      return null;
    }

    const hide = () => {
      list.hidden = true;
      list.innerHTML = '';
    };

    const setValue = (value) => {
      valueInput.value = value;
      input.value = value;
      hide();
    };

    const render = (query = '') => {
      const options = getOptions();
      const q = String(query || '').trim().toLowerCase();
      const matches = (q ? options.filter((item) => item.toLowerCase().includes(q)) : options).slice(0, 8);
      if (!matches.length) {
        hide();
        return;
      }
      list.innerHTML = matches
        .map((item) => `<li role="option"><button type="button" data-combo-option>${item}</button></li>`)
        .join('');
      list.hidden = false;
    };

    input.addEventListener('focus', () => render(input.value));
    input.addEventListener('input', () => {
      if (!allowCustom) valueInput.value = '';
      else valueInput.value = input.value.trim();
      render(input.value);
    });
    input.addEventListener('blur', () => {
      window.setTimeout(() => {
        const typed = input.value.trim();
        if (!typed) {
          setValue('');
          return;
        }
        const exact = getOptions().find((item) => item.toLowerCase() === typed.toLowerCase());
        if (exact) {
          setValue(exact);
          return;
        }
        if (allowCustom) {
          setValue(typed);
          return;
        }
        input.value = valueInput.value;
        hide();
      }, 120);
    });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') hide();
      if (event.key === 'Enter') {
        const first = list.querySelector('[data-combo-option]');
        if (first instanceof HTMLButtonElement) {
          event.preventDefault();
          setValue(first.textContent || '');
        } else if (allowCustom && input.value.trim()) {
          event.preventDefault();
          setValue(input.value.trim());
        }
      }
    });
    list.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest('[data-combo-option]') : null;
      if (!(button instanceof HTMLButtonElement)) return;
      setValue(button.textContent || '');
    });
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      if (!root.contains(event.target)) hide();
    });

    return {
      setValue,
      clear() {
        setValue('');
      },
      getValue() {
        return valueInput.value.trim();
      },
      syncFromHidden() {
        input.value = valueInput.value;
      },
    };
  };

  const cityCombo = setupCombo(
    form?.querySelector('[data-combo="city"]'),
    () => {
      const country = countrySelect instanceof HTMLSelectElement ? countrySelect.value : '';
      return countryCities[country] || [];
    },
    { allowCustom: true },
  );

  const languageCombo = setupCombo(
    form?.querySelector('[data-combo="language"]'),
    () => languageOptions,
    { allowCustom: false },
  );

  countrySelect?.addEventListener('change', () => {
    currencyTouched = false;
    syncCurrencyFromCountry(true);
    syncWhatsappDial();
    const cities = countryCities[countrySelect instanceof HTMLSelectElement ? countrySelect.value : ''] || [];
    if (cityCombo && cityCombo.getValue() && !cities.includes(cityCombo.getValue())) {
      cityCombo.clear();
    }
  });

  currencySelect?.addEventListener('change', () => {
    currencyTouched = Boolean(currencySelect instanceof HTMLSelectElement && currencySelect.value);
    updateRatePlaceholders();
  });

  whatsappNumber?.addEventListener('input', () => {
    if (!(whatsappNumber instanceof HTMLInputElement)) return;
    whatsappNumber.value = whatsappNumber.value.replace(/[^\d\s-]/g, '');
  });

  const clearRateCardFile = () => {
    if (ratePreviewUrl) URL.revokeObjectURL(ratePreviewUrl);
    ratePreviewUrl = '';
    rateCardFile = null;
    if (rateFile instanceof HTMLInputElement) rateFile.value = '';
    if (rateFileHit) rateFileHit.hidden = false;
    if (ratePreview) ratePreview.hidden = true;
    if (ratePreviewImage instanceof HTMLImageElement) {
      ratePreviewImage.removeAttribute('src');
      ratePreviewImage.hidden = true;
    }
    if (ratePreviewName) ratePreviewName.textContent = '';
  };

  const showRateCardFile = (file) => {
    if (ratePreviewUrl) URL.revokeObjectURL(ratePreviewUrl);
    rateCardFile = file;
    const isImage = file.type.startsWith('image/');
    if (rateFileHit) rateFileHit.hidden = true;
    if (ratePreview) ratePreview.hidden = false;
    if (ratePreviewName) ratePreviewName.textContent = file.name;
    if (ratePreviewImage instanceof HTMLImageElement) {
      if (isImage) {
        ratePreviewUrl = URL.createObjectURL(file);
        ratePreviewImage.src = ratePreviewUrl;
        ratePreviewImage.hidden = false;
      } else {
        ratePreviewImage.removeAttribute('src');
        ratePreviewImage.hidden = true;
      }
    }
  };

  const prepareRateCardFile = (file) =>
    new Promise((resolve, reject) => {
      if (!file) {
        resolve(null);
        return;
      }
      const isPdf = file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf');
      if (isPdf) {
        if (file.size > 3_500_000) {
          reject(new Error('PDF must be under 3.5MB.'));
          return;
        }
        resolve(file);
        return;
      }
      if (!file.type.startsWith('image/') && !/\.(jpe?g|png|webp|gif|heic|heif)$/i.test(file.name)) {
        reject(new Error('Please choose a photo, screenshot, or PDF.'));
        return;
      }
      if (file.size > 10_000_000) {
        reject(new Error('Please choose a file under 10MB.'));
        return;
      }
      const url = URL.createObjectURL(file);
      const image = new Image();
      image.onload = () => {
        const max = 1600;
        let width = image.naturalWidth || image.width;
        let height = image.naturalHeight || image.height;
        if (width > max || height > max) {
          const scale = Math.min(max / width, max / height);
          width = Math.round(width * scale);
          height = Math.round(height * scale);
        }
        const canvas = document.createElement('canvas');
        canvas.width = width;
        canvas.height = height;
        const context = canvas.getContext('2d');
        if (!context) {
          URL.revokeObjectURL(url);
          resolve(file.size <= 3_500_000 ? file : null);
          return;
        }
        context.drawImage(image, 0, 0, width, height);
        canvas.toBlob(
          (blob) => {
            URL.revokeObjectURL(url);
            if (!blob) {
              resolve(file.size <= 3_500_000 ? file : null);
              return;
            }
            const name = file.name.replace(/\.[^.]+$/, '') || 'rate-card';
            resolve(new File([blob], `${name}.jpg`, { type: 'image/jpeg' }));
          },
          'image/jpeg',
          0.82,
        );
      };
      image.onerror = () => {
        URL.revokeObjectURL(url);
        if (file.size > 3_500_000) {
          reject(new Error('Please use a JPG, PNG, or PDF under 3.5MB.'));
          return;
        }
        resolve(file);
      };
      image.src = url;
    });

  rateFile?.addEventListener('change', () => {
    const file = rateFile instanceof HTMLInputElement ? rateFile.files?.[0] : null;
    if (!file) return;
    if (file.size > 10_000_000) {
      clearRateCardFile();
      setStatus('Please choose a file under 10MB.', 'info');
      return;
    }
    showRateCardFile(file);
    setStatus('');
    form?.querySelector('[data-rate-upload]')?.closest('.creator-join-form__fold')?.setAttribute('open', '');
  });

  rateFileClear?.addEventListener('click', () => {
    clearRateCardFile();
    setStatus('');
  });

  const syncTags = () => {
    if (!tagList || !tagValue) return;
    tagList.innerHTML = '';
    selectedTags.forEach((tag) => {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'creator-join-form__tag';
      chip.innerHTML = `<span>#${tag}</span><span aria-hidden="true">×</span>`;
      chip.setAttribute('aria-label', `Remove ${tag}`);
      chip.addEventListener('click', () => {
        const index = selectedTags.indexOf(tag);
        if (index >= 0) selectedTags.splice(index, 1);
        syncTags();
        setStatus('');
        tagInput?.focus();
      });
      tagList.appendChild(chip);
    });
    tagValue.value = selectedTags.map((tag) => `#${tag}`).join(' ');
  };

  const normalizeTag = (value) =>
    String(value || '')
      .trim()
      .replace(/^#+/, '')
      .replace(/\s+/g, '');

  const addTag = (raw) => {
    const tag = normalizeTag(raw);
    if (!tag) return false;
    if (selectedTags.some((item) => item.toLowerCase() === tag.toLowerCase())) {
      setStatus('Tag already added.', 'info');
      return false;
    }
    if (selectedTags.length >= maxTags) {
      setStatus(`Up to ${maxTags} tags.`, 'info');
      return false;
    }
    selectedTags.push(tag);
    syncTags();
    setStatus('');
    return true;
  };

  const hideSuggest = () => {
    if (!tagSuggest) return;
    tagSuggest.hidden = true;
    tagSuggest.innerHTML = '';
    tagInput?.setAttribute('aria-expanded', 'false');
  };

  const availableSuggestions = () =>
    allTagSuggestions.filter(
      (item) => !selectedTags.some((tag) => tag.toLowerCase() === item.toLowerCase()),
    );

  const rankSuggestions = (query) => {
    const q = normalizeTag(query).toLowerCase();
    const pool = availableSuggestions();
    if (!q) return pool.slice(0, 8);
    const starts = [];
    const contains = [];
    for (const item of pool) {
      const lower = item.toLowerCase();
      if (lower.startsWith(q)) starts.push(item);
      else if (q.length >= 2 && lower.includes(q)) contains.push(item);
    }
    return [...starts, ...contains].slice(0, 8);
  };

  const renderSuggest = (query) => {
    if (!tagSuggest || !tagInput) return;
    if (selectedTags.length >= maxTags) {
      hideSuggest();
      return;
    }
    const matches = rankSuggestions(query);
    if (!matches.length) {
      hideSuggest();
      return;
    }
    tagSuggest.innerHTML = matches
      .map(
        (item) =>
          `<li role="option"><button type="button" data-tag-option><span aria-hidden="true">#</span>${item}</button></li>`,
      )
      .join('');
    tagSuggest.hidden = false;
    tagInput.setAttribute('aria-expanded', 'true');
  };

  tagInput?.addEventListener('focus', () => renderSuggest(tagInput.value));
  tagInput?.addEventListener('click', () => renderSuggest(tagInput.value));
  tagInput?.addEventListener('input', () => renderSuggest(tagInput.value));
  tagInput?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ',' || event.key === 'Tab') {
      const value = tagInput.value.trim();
      if (!value) return;
      event.preventDefault();
      if (addTag(value)) {
        tagInput.value = '';
        renderSuggest('');
      } else {
        renderSuggest(tagInput.value);
      }
    } else if (event.key === 'Backspace' && !tagInput.value && selectedTags.length) {
      selectedTags.pop();
      syncTags();
      renderSuggest('');
    } else if (event.key === 'Escape') {
      hideSuggest();
    }
  });

  tagSuggest?.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest('[data-tag-option]') : null;
    if (!(button instanceof HTMLButtonElement)) return;
    if (addTag(button.textContent || '')) {
      if (tagInput) tagInput.value = '';
      tagInput?.focus();
      renderSuggest('');
    }
  });

  document.addEventListener('click', (event) => {
    if (tagField && event.composedPath().includes(tagField)) return;
    hideSuggest();
  });

  const usedPlatforms = () =>
    [...(socialList?.querySelectorAll('[data-social-platform]') ?? [])]
      .map((input) => (input instanceof HTMLInputElement ? input.value : ''))
      .filter(Boolean);

  const closePlatformLists = (except) => {
    socialList?.querySelectorAll('[data-platform-list]').forEach((list) => {
      if (list !== except) list.hidden = true;
    });
    socialList?.querySelectorAll('[data-platform-toggle]').forEach((btn) => {
      btn.setAttribute('aria-expanded', 'false');
    });
  };

  const setPlatformValue = (row, name) => {
    const input = row.querySelector('[data-social-platform]');
    const label = row.querySelector('[data-platform-label]');
    const icon = row.querySelector('[data-platform-icon]');
    const platform = platformByName(name);
    if (input instanceof HTMLInputElement) input.value = name || '';
    if (label) label.textContent = name || 'Choose platform';
    row.querySelector('[data-platform-toggle]')?.classList.toggle('is-empty', !name);
    row.querySelector('.creator-join-form__field--platform')?.classList.remove('is-invalid');
    input?.classList.remove('is-invalid');
    if (icon instanceof HTMLImageElement) {
      if (platform?.icon) {
        icon.src = platform.icon;
        icon.alt = '';
        icon.hidden = false;
      } else {
        icon.removeAttribute('src');
        icon.hidden = true;
      }
    }
    row.querySelector('[data-platform-list]')?.setAttribute('hidden', '');
    row.querySelector('[data-platform-toggle]')?.setAttribute('aria-expanded', 'false');
  };

  const refreshPlatformOptions = () => {
    const used = usedPlatforms();
    socialList?.querySelectorAll('[data-social-item]').forEach((row) => {
      const list = row.querySelector('[data-platform-list]');
      const current = row.querySelector('[data-social-platform]');
      if (!(list instanceof HTMLElement) || !(current instanceof HTMLInputElement)) return;
      list.innerHTML = platforms
        .map((platform) => {
          const taken = used.includes(platform.name) && platform.name !== current.value;
          return `<li role="option">
            <button type="button" data-platform-option="${platform.name}" ${taken ? 'disabled' : ''}>
              <img src="${platform.icon}" alt="" width="20" height="20" />
              <span>${platform.name}</span>
            </button>
          </li>`;
        })
        .join('');
    });
  };

  const clearSocialRow = (row) => {
    const handle = row.querySelector('[data-social-handle]');
    setPlatformValue(row, '');
    if (handle instanceof HTMLInputElement) {
      handle.value = '';
      handle.classList.remove('is-invalid');
    }
    row.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
    refreshPlatformOptions();
  };

  const bindSocialRow = (row) => {
    const toggle = row.querySelector('[data-platform-toggle]');
    const list = row.querySelector('[data-platform-list]');
    const remove = row.querySelector('[data-remove-social]');

    toggle?.addEventListener('click', (event) => {
      event.stopPropagation();
      const open = list instanceof HTMLElement && !list.hidden;
      closePlatformLists();
      if (list instanceof HTMLElement) {
        list.hidden = open;
        toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
      }
    });

    list?.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest('[data-platform-option]') : null;
      if (!(button instanceof HTMLButtonElement) || button.disabled) return;
      setPlatformValue(row, button.getAttribute('data-platform-option') || '');
      refreshPlatformOptions();
    });

    remove?.addEventListener('click', () => {
      const count = socialList?.querySelectorAll('[data-social-item]').length ?? 0;
      if (count <= 1) {
        clearSocialRow(row);
        setStatus('');
        return;
      }
      row.remove();
      renameSocialRows();
      refreshPlatformOptions();
      if (addSocial) addSocial.hidden = false;
      setStatus('');
    });
  };

  const addSocialRow = (platform = '', handle = '') => {
    if (!socialList || !socialTemplate || !(socialTemplate instanceof HTMLTemplateElement)) return;
    const count = socialList.querySelectorAll('[data-social-item]').length;
    if (count >= maxSocials) {
      setStatus(`Up to ${maxSocials} platforms.`, 'info');
      if (addSocial) addSocial.hidden = true;
      return;
    }
    const node = socialTemplate.content.cloneNode(true);
    const row = node.querySelector('[data-social-item]');
    const select = node.querySelector('[data-social-platform]');
    const input = node.querySelector('[data-social-handle]');
    if (input instanceof HTMLInputElement) {
      input.name = `socialHandle${count + 1}`;
      input.value = handle;
    }
    if (select instanceof HTMLInputElement) select.name = `socialPlatform${count + 1}`;
    if (row) bindSocialRow(row);
    socialList.appendChild(node);
    if (row) setPlatformValue(row, normalizePlatform(platform));
    refreshPlatformOptions();
    if (count + 1 >= maxSocials && addSocial) addSocial.hidden = true;
  };

  const renameSocialRows = () => {
    socialList?.querySelectorAll('[data-social-item]').forEach((row, index) => {
      const select = row.querySelector('[data-social-platform]');
      const input = row.querySelector('[data-social-handle]');
      if (select instanceof HTMLInputElement) select.name = `socialPlatform${index + 1}`;
      if (input instanceof HTMLInputElement) input.name = `socialHandle${index + 1}`;
    });
  };

  addSocial?.addEventListener('click', () => {
    addSocialRow();
    form?.querySelector('[data-validate-block="socials"]')?.classList.remove('is-invalid');
    const last = socialList?.querySelector('[data-social-item]:last-child [data-platform-toggle]');
    if (last instanceof HTMLButtonElement) last.focus();
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (event.target instanceof Element && event.target.closest('[data-platform-picker]')) return;
    closePlatformLists();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closePlatformLists();
  });

  categories?.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement) || target.type !== 'checkbox') return;
    const checked = categories.querySelectorAll('input:checked');
    if (checked.length > 3) {
      target.checked = false;
      setStatus('Up to 3 categories.', 'info');
    } else if (status?.textContent === 'Up to 3 categories.') {
      setStatus('');
    }
  });

  const renameCollabRows = () => {
    collabs?.querySelectorAll('[data-collab-item]').forEach((row, index) => {
      const brand = row.querySelector('[data-collab-brand]');
      const link = row.querySelector('[data-collab-link]');
      if (brand instanceof HTMLInputElement) brand.name = `collabBrand${index + 1}`;
      if (link instanceof HTMLInputElement) link.name = `collabLink${index + 1}`;
    });
  };

  const bindCollabRow = (row) => {
    row.querySelector('[data-remove-collab]')?.addEventListener('click', () => {
      row.remove();
      renameCollabRows();
      if (addCollab) addCollab.hidden = false;
      setStatus('');
    });
  };

  const addCollabRow = (brandValue = '', linkValue = '') => {
    if (!collabs || !collabTemplate || !(collabTemplate instanceof HTMLTemplateElement)) return;
    const count = collabs.querySelectorAll('[data-collab-item]').length;
    if (count >= 3) {
      setStatus('Up to 3 collaborations.', 'info');
      if (addCollab) addCollab.hidden = true;
      return;
    }
    const node = collabTemplate.content.cloneNode(true);
    const row = node.querySelector('[data-collab-item]');
    const brand = node.querySelector('[data-collab-brand]');
    const link = node.querySelector('[data-collab-link]');
    const next = count + 1;
    if (brand instanceof HTMLInputElement) {
      brand.name = `collabBrand${next}`;
      brand.value = brandValue;
    }
    if (link instanceof HTMLInputElement) {
      link.name = `collabLink${next}`;
      link.value = linkValue;
    }
    if (row) bindCollabRow(row);
    collabs.appendChild(node);
    if (count + 1 >= 3 && addCollab) addCollab.hidden = true;
  };

  addCollab?.addEventListener('click', () => {
    addCollabRow();
    const last = collabs?.querySelector('[data-collab-item]:last-child [data-collab-brand]');
    if (last instanceof HTMLInputElement) last.focus();
  });

  const maxScopes = 10;

  const usedScopes = () =>
    [...(scopeList?.querySelectorAll('[data-scope-name]') ?? [])]
      .map((input) => (input instanceof HTMLInputElement ? input.value : ''))
      .filter(Boolean);

  const syncScopeUi = () => {
    const count = scopeList?.querySelectorAll('[data-scope-item]').length ?? 0;
    if (scopeCount instanceof HTMLElement) {
      scopeCount.textContent = String(count);
      scopeCount.hidden = count === 0;
    }
    if (scopeEmpty) scopeEmpty.hidden = count > 0;
    if (addScope) addScope.hidden = count >= maxScopes;
  };

  const closeScopeMenu = () => {
    if (scopeMenu instanceof HTMLElement) {
      scopeMenu.hidden = true;
      scopeMenu.classList.remove('is-up');
    }
  };

  const positionScopeMenu = () => {
    if (!(scopeMenu instanceof HTMLElement) || !(addScope instanceof HTMLElement)) return;
    scopeMenu.classList.remove('is-up');
    const trigger = addScope.getBoundingClientRect();
    const footer = document.querySelector('.creator-join-form__footer');
    const footerHeight =
      footer instanceof HTMLElement ? Math.max(0, window.innerHeight - footer.getBoundingClientRect().top) : 0;
    const menuHeight = Math.min(scopeMenu.offsetHeight || 280, window.innerHeight * 0.42);
    const spaceBelow = window.innerHeight - trigger.bottom - footerHeight - 12;
    const spaceAbove = trigger.top - 12;
    if (spaceBelow < menuHeight && spaceAbove > spaceBelow) {
      scopeMenu.classList.add('is-up');
    }
  };

  const scopeKind = (scopeName) => {
    const addonGroup = rateScopeGroups.find((group) => /add-?ons/i.test(group.label || ''));
    return addonGroup?.items?.includes(scopeName) ? 'addon' : 'deliverable';
  };

  const refreshScopeOptions = () => {
    if (!scopeOptions) return;
    const used = usedScopes();
    const html = rateScopeGroups
      .map((group) => {
        const items = group.items || [];
        if (!items.length) return '';
        const kind = /add-?ons/i.test(group.label || '') ? 'addon' : 'deliverable';
        return `<div class="creator-join-form__scope-group" data-scope-kind="${kind}">
          <p class="creator-join-form__scope-menu-label">${group.label}</p>
          <ul>
            ${items
              .map((name) => {
                const taken = used.includes(name);
                return `<li><button type="button" data-scope-option="${name}" data-scope-kind="${kind}" ${taken ? 'disabled' : ''}>${name}</button></li>`;
              })
              .join('')}
          </ul>
        </div>`;
      })
      .join('');
    scopeOptions.innerHTML = html;
  };

  const renameScopeRows = () => {
    scopeList?.querySelectorAll('[data-scope-item]').forEach((row, index) => {
      const name = row.querySelector('[data-scope-name]');
      const price = row.querySelector('[data-scope-price]');
      if (name instanceof HTMLInputElement) name.name = `rateScope${index + 1}`;
      if (price instanceof HTMLInputElement) price.name = `ratePrice${index + 1}`;
    });
  };

  const bindScopeRow = (row) => {
    row.querySelector('[data-remove-scope]')?.addEventListener('click', () => {
      row.remove();
      renameScopeRows();
      refreshScopeOptions();
      syncScopeUi();
      setStatus('');
    });
  };

  const addScopeRow = (scopeName = '', priceValue = '') => {
    if (!scopeList || !scopeTemplate || !(scopeTemplate instanceof HTMLTemplateElement)) return;
    const count = scopeList.querySelectorAll('[data-scope-item]').length;
    if (count >= maxScopes) {
      setStatus(`Up to ${maxScopes} scopes.`, 'info');
      closeScopeMenu();
      syncScopeUi();
      return;
    }
    if (scopeName && usedScopes().includes(scopeName)) return;
    const node = scopeTemplate.content.cloneNode(true);
    const row = node.querySelector('[data-scope-item]');
    const name = node.querySelector('[data-scope-name]');
    const label = node.querySelector('[data-scope-label]');
    const price = node.querySelector('[data-scope-price]');
    if (name instanceof HTMLInputElement) {
      name.name = `rateScope${count + 1}`;
      name.value = scopeName;
    }
    if (label) label.textContent = scopeName;
    if (price instanceof HTMLInputElement) {
      price.name = `ratePrice${count + 1}`;
      price.value = priceValue;
    }
    if (row instanceof HTMLElement) {
      row.dataset.scopeKind = scopeKind(scopeName);
      row.classList.toggle('creator-join-form__scope--addon', scopeKind(scopeName) === 'addon');
      bindScopeRow(row);
    }
    scopeList.appendChild(node);
    updateRatePlaceholders();
    refreshScopeOptions();
    syncScopeUi();
    closeScopeMenu();
  };

  addScope?.addEventListener('click', (event) => {
    event.stopPropagation();
    if (!(scopeMenu instanceof HTMLElement)) return;
    const open = !scopeMenu.hidden;
    if (open) {
      closeScopeMenu();
      return;
    }
    refreshScopeOptions();
    scopeMenu.hidden = false;
    requestAnimationFrame(positionScopeMenu);
  });

  scopeOptions?.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest('[data-scope-option]') : null;
    if (!(button instanceof HTMLButtonElement) || button.disabled) return;
    addScopeRow(button.getAttribute('data-scope-option') || '');
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest('[data-scope-picker]')) return;
    closeScopeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeScopeMenu();
  });

  form?.addEventListener('input', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target instanceof HTMLInputElement && target.hasAttribute('data-birthday')) formatBirthdayInput(target);
    target.classList.remove('is-invalid');
    target.closest('.creator-join-form__field')?.classList.remove('is-invalid');
    target.closest('[data-validate-block]')?.classList.remove('is-invalid');
  });

  form?.addEventListener('change', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    target.classList.remove('is-invalid');
    target.closest('.creator-join-form__field')?.classList.remove('is-invalid');
    target.closest('[data-validate-block]')?.classList.remove('is-invalid');
  });

  const validateForm = () => {
    clearInvalid();
    setStatus('');

    for (const field of form?.querySelectorAll('[data-required]') ?? []) {
      if (!(field instanceof HTMLInputElement || field instanceof HTMLSelectElement)) continue;
      const value = String(field.value ?? '').trim();
      if (!value) {
        markInvalid(field);
        focusInvalid(field);
        return false;
      }
      if (field instanceof HTMLInputElement && field.type === 'email' && !isValidEmail(value)) {
        markInvalid(field);
        focusInvalid(field);
        return false;
      }
    }

    const birthday = form?.querySelector('[data-birthday]');
    if (birthday instanceof HTMLInputElement && birthday.value.trim() && !isValidBirthday(birthday.value.trim())) {
      markInvalid(birthday);
      focusInvalid(birthday);
      setStatus('Use YYYY-MM-DD for date of birth.', 'info');
      return false;
    }

    const socialRows = [...(socialList?.querySelectorAll('[data-social-item]') ?? [])];
    const validSocials = socialRows.filter((row) => {
      const platform = row.querySelector('[data-social-platform]');
      const handle = row.querySelector('[data-social-handle]');
      return (
        platform instanceof HTMLInputElement &&
        handle instanceof HTMLInputElement &&
        platform.value &&
        handle.value.trim()
      );
    });

    if (!validSocials.length) {
      if (!socialRows.length) addSocialRow();
      const firstPlatform = socialList?.querySelector('[data-social-platform]');
      const firstHandle = socialList?.querySelector('[data-social-handle]');
      markInvalid(firstPlatform instanceof Element ? firstPlatform : null);
      markInvalid(firstHandle instanceof Element ? firstHandle : null);
      form?.querySelector('[data-validate-block="socials"]')?.classList.add('is-invalid');
      focusInvalid(firstPlatform instanceof HTMLElement ? firstPlatform : null);
      return false;
    }

    for (const row of socialRows) {
      const platform = row.querySelector('[data-social-platform]');
      const handle = row.querySelector('[data-social-handle]');
      if (!(platform instanceof HTMLInputElement) || !(handle instanceof HTMLInputElement)) continue;
      const hasPlatform = Boolean(platform.value);
      const hasHandle = Boolean(handle.value.trim());
      if (hasPlatform !== hasHandle) {
        markInvalid(hasPlatform ? handle : platform);
        focusInvalid(hasPlatform ? handle : platform);
        return false;
      }
    }

    return true;
  };

  const ensureDefaultSocialRow = () => {
    if (!socialList?.querySelector('[data-social-item]')) addSocialRow();
    if (addSocial) addSocial.hidden = false;
  };

  const resetDynamicFields = () => {
    selectedTags.length = 0;
    syncTags();
    if (tagInput) tagInput.value = '';
    hideSuggest();
    socialList?.replaceChildren();
    ensureDefaultSocialRow();
    collabs?.replaceChildren();
    if (addCollab) addCollab.hidden = false;
    scopeList?.replaceChildren();
    refreshScopeOptions();
    syncScopeUi();
    clearRateCardFile();
  };

  const collectDraft = () => {
    if (!form) return null;
    const data = new FormData(form);
    const fields = {};
    for (const [key, value] of data.entries()) {
      if (typeof value !== 'string') continue;
      if (key === 'categories' || key === 'company' || key === 'tags') continue;
      if (/^rate(Scope|Price)\d+$/.test(key)) continue;
      fields[key] = String(value);
    }
    return {
      fields,
      categories: data.getAll('categories').map(String),
      tags: [...selectedTags],
      currencyTouched,
      socials: [...(socialList?.querySelectorAll('[data-social-item]') ?? [])]
        .map((row) => {
          const platform = row.querySelector('[data-social-platform]');
          const handle = row.querySelector('[data-social-handle]');
          return {
            platform: platform instanceof HTMLInputElement ? platform.value : '',
            handle: handle instanceof HTMLInputElement ? handle.value : '',
          };
        })
        .filter((item) => item.platform || item.handle),
      collabs: [...(collabs?.querySelectorAll('[data-collab-item]') ?? [])]
        .map((row) => {
          const brand = row.querySelector('[data-collab-brand]');
          const link = row.querySelector('[data-collab-link]');
          return {
            brand: brand instanceof HTMLInputElement ? brand.value : '',
            link: link instanceof HTMLInputElement ? link.value : '',
          };
        })
        .filter((item) => item.brand || item.link),
      rates: [...(scopeList?.querySelectorAll('[data-scope-item]') ?? [])]
        .map((row) => {
          const name = row.querySelector('[data-scope-name]');
          const price = row.querySelector('[data-scope-price]');
          return {
            scope: name instanceof HTMLInputElement ? name.value : '',
            price: price instanceof HTMLInputElement ? price.value : '',
          };
        })
        .filter((item) => item.scope || item.price),
      savedAt: Date.now(),
    };
  };

  const saveDraft = () => {
    try {
      const draft = collectDraft();
      if (!draft) return;
      localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
      setStatus('Draft saved on this device.', 'success');
    } catch {
      setStatus('Unable to save draft in this browser.', 'error');
    }
  };

  const clearDraft = () => {
    try {
      localStorage.removeItem(DRAFT_KEY);
    } catch {
      /* ignore */
    }
  };

  const applyDraft = (draft) => {
    if (!form || !draft || typeof draft !== 'object') return;

    Object.entries(draft.fields || {}).forEach(([key, value]) => {
      const field = form.elements.namedItem(key);
      if (field instanceof RadioNodeList) return;
      if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement) {
        field.value = String(value ?? '');
      }
    });

    cityCombo?.syncFromHidden();
    languageCombo?.syncFromHidden();
    syncWhatsappDial();
    if (draft.fields?.whatsappDial && whatsappDial) {
      whatsappDial.textContent = String(draft.fields.whatsappDial);
    }
    if (draft.fields?.whatsappDial && whatsappDialValue instanceof HTMLInputElement) {
      whatsappDialValue.value = String(draft.fields.whatsappDial);
    }

    categories?.querySelectorAll('input[type="checkbox"]').forEach((input) => {
      if (input instanceof HTMLInputElement) {
        input.checked = Array.isArray(draft.categories) && draft.categories.includes(input.value);
      }
    });

    selectedTags.length = 0;
    if (Array.isArray(draft.tags)) {
      draft.tags.forEach((tag) => {
        if (typeof tag === 'string' && tag) selectedTags.push(tag);
      });
    }
    syncTags();

    socialList?.replaceChildren();
    if (addSocial) addSocial.hidden = false;
    if (Array.isArray(draft.socials) && draft.socials.length) {
      draft.socials.forEach((item) => addSocialRow(item?.platform || '', item?.handle || ''));
    } else {
      ensureDefaultSocialRow();
    }

    collabs?.replaceChildren();
    if (addCollab) addCollab.hidden = false;
    if (Array.isArray(draft.collabs) && draft.collabs.length) {
      draft.collabs.forEach((item) => addCollabRow(item?.brand || '', item?.link || ''));
      document.querySelectorAll('.creator-join-form__fold').forEach((fold) => {
        if (fold instanceof HTMLDetailsElement) fold.open = true;
      });
    }

    scopeList?.replaceChildren();
    const restoredRates = Array.isArray(draft.rates)
      ? draft.rates
      : [
          { scope: 'IG Reel', price: draft.fields?.rateReels },
          { scope: 'IG Carousel', price: draft.fields?.rateCarousel },
          { scope: 'IG Story', price: draft.fields?.rateStory },
          { scope: 'IG Live', price: draft.fields?.rateLive },
        ].filter((item) => item.price);
    restoredRates.forEach((item) => {
      if (item?.scope || item?.price) addScopeRow(item?.scope || '', item?.price || '');
    });
    refreshScopeOptions();
    syncScopeUi();

    const hasRates =
      Boolean(draft.fields?.currency) ||
      (Array.isArray(draft.rates) && draft.rates.length > 0) ||
      Boolean(draft.fields?.rateReels) ||
      Boolean(draft.fields?.rateCarousel) ||
      Boolean(draft.fields?.rateStory) ||
      Boolean(draft.fields?.rateLive);
    if (hasRates || draft.fields?.notes) {
      document.querySelectorAll('.creator-join-form__fold').forEach((fold) => {
        if (fold instanceof HTMLDetailsElement) fold.open = true;
      });
    }

    currencyTouched = Boolean(draft.currencyTouched);
    if (!currencyTouched) syncCurrencyFromCountry(true);
    updateRatePlaceholders();
  };

  const restoreDraft = () => {
    try {
      const raw = localStorage.getItem(DRAFT_KEY);
      if (!raw) return;
      applyDraft(JSON.parse(raw));
      setStatus('Draft restored.', 'info');
    } catch {
      clearDraft();
    }
  };

  draftBtn?.addEventListener('click', saveDraft);

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !status || !submit) return;
    if (!validateForm()) return;

    renameSocialRows();
    renameCollabRows();
    renameScopeRows();
    const data = new FormData(form);
    const get = (key) => String(data.get(key) ?? '').trim();

    const socials = [...(socialList?.querySelectorAll('[data-social-item]') ?? [])]
      .map((row) => {
        const platform = row.querySelector('[data-social-platform]');
        const handle = row.querySelector('[data-social-handle]');
        if (!(platform instanceof HTMLInputElement) || !(handle instanceof HTMLInputElement)) return null;
        if (!platform.value || !handle.value.trim()) return null;
        return `${platform.value}: ${handle.value.trim()}`;
      })
      .filter(Boolean);

    const rates = [...(scopeList?.querySelectorAll('[data-scope-item]') ?? [])]
      .map((row) => {
        const name = row.querySelector('[data-scope-name]');
        const price = row.querySelector('[data-scope-price]');
        const scope = name instanceof HTMLInputElement ? name.value.trim() : '';
        const amount = price instanceof HTMLInputElement ? price.value.trim() : '';
        if (!scope && !amount) return null;
        return `${scope || '—'}: ${amount || '—'}`;
      })
      .filter(Boolean);

    const collabList = [1, 2, 3]
      .map((index) => {
        const brand = get(`collabBrand${index}`);
        const link = get(`collabLink${index}`);
        if (!brand && !link) return null;
        return `${brand || '—'} | ${link || '—'}`;
      })
      .filter(Boolean);

    const message = [
      'Creator join application from moca-web',
      '',
      `Account name: ${get('accountName')}`,
      `Gender: ${get('gender') || '—'}`,
      `Date of birth: ${get('birthday') || '—'}`,
      `Country: ${get('country') || '—'}`,
      `City: ${get('city') || '—'}`,
      `Language: ${get('language') || '—'}`,
      `WhatsApp: ${
        get('whatsappNumber')
          ? `${get('whatsappDial') || ''} ${get('whatsappNumber')}`.trim()
          : '—'
      }`,
      `Categories: ${data.getAll('categories').map(String).join(', ') || '—'}`,
      `Tags: ${get('tags') || '—'}`,
      '',
      'Social accounts:',
      ...(socials.length ? socials.map((item) => `- ${item}`) : ['- —']),
      '',
      'Rate card:',
      `Currency: ${get('currency') || '—'}`,
      `Rate card file: ${rateCardFile ? rateCardFile.name : '—'}`,
      ...(rates.length ? rates.map((item) => `- ${item}${get('currency') ? ` ${get('currency')}` : ''}`) : ['- —']),
      '',
      'Collaboration history:',
      ...(collabList.length ? collabList.map((item, index) => `- #${index + 1}: ${item}`) : ['- —']),
      '',
      `Notes: ${get('notes') || '—'}`,
    ].join('\n');

    const payload = new FormData();
    payload.set('name', get('accountName'));
    payload.set('email', get('email'));
    payload.set('subject', 'Creator Join Application');
    payload.set('message', message);
    payload.set('company', get('company'));

    setCreatorSubmitting(true);
    setStatus('Submitting…', 'info');

    try {
      if (rateCardFile) {
        setCreatorSubmitting(true, 'Preparing…');
        setStatus('Preparing photo…', 'info');
        const attachment = await prepareRateCardFile(rateCardFile);
        if (attachment) payload.set('rateCard', attachment);
        setCreatorSubmitting(true);
        setStatus('Submitting…', 'info');
      }
      const response = await fetch(contactEndpoint, {
        method: 'POST',
        body: payload,
        headers: { Accept: 'application/json' },
      });
      const result = await response.json();
      if (!response.ok) throw new Error(result.message || 'Unable to submit your application.');

      form.reset();
      resetDynamicFields();
      clearRateCardFile();
      clearDraft();
      currencyTouched = false;
      cityCombo?.clear();
      languageCombo?.clear();
      syncCurrencyFromCountry(true);
      syncWhatsappDial();
      updateRatePlaceholders();
      setStatus('', 'success');
      showCreatorSuccess('Thanks — your application has been sent. We’ll be in touch.');
    } catch (error) {
      setStatus(error instanceof Error ? error.message : 'Unable to submit your application.', 'error');
    } finally {
      setCreatorSubmitting(false);
    }
  });

  syncCurrencyFromCountry(true);
  syncWhatsappDial();
  updateRatePlaceholders();
  refreshScopeOptions();
  syncScopeUi();
  ensureDefaultSocialRow();
  restoreDraft();
</script>
