---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const policySections = [
  { id: 'scope', label: 'Scope' },
  { id: 'information-we-collect', label: 'Information we collect' },
  { id: 'how-we-use-information', label: 'How we use information' },
  { id: 'advertising-data', label: 'Advertising data' },
  { id: 'sharing', label: 'How information is shared' },
  { id: 'retention-security', label: 'Retention and security' },
  { id: 'international-transfers', label: 'International transfers' },
  { id: 'your-rights', label: 'Your rights' },
  { id: 'children', label: 'Children’s privacy' },
  { id: 'changes', label: 'Changes to this policy' },
  { id: 'contact-us', label: 'Contact us' },
];
---

<BaseLayout
  title="Privacy Policy"
  description="Learn how MOCA Technology collects, uses, protects, and shares information through this website and its advertising services."
>
  <header class="legal-hero">
    <div class="container legal-hero__inner">
      <p class="eyebrow">Legal & privacy</p>
      <h1>Privacy Policy</h1>
      <p class="legal-hero__intro">
        This policy explains how MOCA Technology handles information when you
        visit our website, contact our team, or interact with our advertising
        services.
      </p>
      <dl class="legal-meta">
        <div>
          <dt>Last updated</dt>
          <dd>{site.legal.policyUpdatedAt}</dd>
        </div>
        <div>
          <dt>Contact</dt>
          <dd>
            <a href={`mailto:${site.contact.cooperationEmail}`}>
              {site.contact.cooperationEmail}
            </a>
          </dd>
        </div>
      </dl>
    </div>
  </header>

  <section class="legal-section">
    <div class="container legal-layout">
      <aside class="legal-sidebar">
        <nav aria-label="Privacy policy sections">
          <p class="legal-sidebar__title">On this page</p>
          <ol>
            {policySections.map((section) => (
              <li><a href={`#${section.id}`}>{section.label}</a></li>
            ))}
          </ol>
        </nav>
      </aside>

      <article class="legal-document">
        <section id="scope">
          <p class="legal-section-number">01</p>
          <h2>Scope</h2>
          <p>
            This Privacy Policy applies to information processed through
            moca-tech.net, our contact channels, and MOCA advertising services.
            It does not control the privacy practices of third-party websites,
            platforms, publishers, or advertisers that may be linked from our
            website.
          </p>
        </section>

        <section id="information-we-collect">
          <p class="legal-section-number">02</p>
          <h2>Information we collect</h2>
          <h3>Information you provide</h3>
          <p>
            When you use our contact form or email us, we may collect your name,
            email address, subject, message, company information, and any other
            details you choose to provide.
          </p>
          <h3>Technical information</h3>
          <p>
            Our hosting and security providers may process standard request
            information such as IP address, browser and device type, referring
            URL, page URL, timestamps, and diagnostic or security logs. IP
            addresses are treated as personal data where required by applicable
            law.
          </p>
          <p>
            This website does not currently use non-essential advertising or
            analytics cookies. If that changes, we will provide notice and
            consent choices where required.
          </p>
        </section>

        <section id="how-we-use-information">
          <p class="legal-section-number">03</p>
          <h2>How we use information</h2>
          <p>We use information where necessary to:</p>
          <ul>
            <li>respond to enquiries and provide requested services;</li>
            <li>operate, maintain, secure, and improve our website and services;</li>
            <li>prevent fraud, misuse, and security incidents;</li>
            <li>measure advertising delivery and attribution where permitted; and</li>
            <li>meet contractual, regulatory, and legal obligations.</li>
          </ul>
          <p>
            Depending on the context and jurisdiction, our legal basis may be
            your consent, performance of a contract, compliance with law, or our
            legitimate interests in operating and protecting our business.
          </p>
        </section>

        <section id="advertising-data">
          <p class="legal-section-number">04</p>
          <h2>Advertising and interaction data</h2>
          <p>
            In connection with advertising delivery, MOCA may process
            non-personal or anonymized information such as creative assets,
            referring and page URLs, browser type, ad size, and interaction
            events. We process IP addresses only for legitimate purposes such as
            fraud prevention, security, and permitted advertising attribution.
          </p>
          <p>
            We do not collect, store, or use personal data through advertising
            interactions without a valid legal basis. Unless authorized by the
            relevant partner or advertiser, interaction data is not used in a
            way designed to identify an advertiser, its branded products, or its
            services.
          </p>
        </section>

        <section id="sharing">
          <p class="legal-section-number">05</p>
          <h2>How information is shared</h2>
          <p>
            We may share information with hosting, security, email delivery, and
            other service providers that process data on our behalf; with
            advertising partners where necessary to provide contracted services;
            or with authorities when required by law. Providers receive only the
            information reasonably necessary for their role and are expected to
            protect it.
          </p>
          <p>MOCA does not sell or rent personal data.</p>
        </section>

        <section id="retention-security">
          <p class="legal-section-number">06</p>
          <h2>Retention and security</h2>
          <p>
            We retain personal data only for as long as needed for the purposes
            described in this policy, including to resolve enquiries, provide
            services, maintain appropriate business records, and meet legal
            obligations.
          </p>
          <p>
            We use reasonable administrative, technical, and organizational
            safeguards designed to protect information. No online service or
            transmission method can, however, guarantee absolute security.
          </p>
        </section>

        <section id="international-transfers">
          <p class="legal-section-number">07</p>
          <h2>International transfers</h2>
          <p>
            MOCA operates across multiple markets. Information may therefore be
            processed outside the country where it was collected. Where required,
            we use appropriate contractual or legal safeguards for international
            transfers.
          </p>
        </section>

        <section id="your-rights">
          <p class="legal-section-number">08</p>
          <h2>Your rights</h2>
          <p>
            Subject to applicable law, you may request access to, correction of,
            deletion of, or a copy of your personal data. You may also ask us to
            restrict processing, object to certain uses, withdraw consent, or opt
            out of tracking where applicable.
          </p>
          <p>
            To make a request, email
            <a href={`mailto:${site.contact.cooperationEmail}`}>
              {site.contact.cooperationEmail}
            </a>. We may need to verify your identity before completing it.
          </p>
        </section>

        <section id="children">
          <p class="legal-section-number">09</p>
          <h2>Children’s privacy</h2>
          <p>
            Our website and business services are intended for organizations and
            business users, not children. We do not knowingly collect personal
            data from children through this website.
          </p>
        </section>

        <section id="changes">
          <p class="legal-section-number">10</p>
          <h2>Changes to this policy</h2>
          <p>
            We may update this policy as our services, practices, or legal
            obligations change. The date at the top of this page identifies the
            latest revision. Material changes will be communicated through an
            appropriate notice.
          </p>
        </section>

        <section id="contact-us">
          <p class="legal-section-number">11</p>
          <h2>Contact us</h2>
          <p>
            For privacy questions or requests, contact MOCA Technology at
            <a href={`mailto:${site.contact.cooperationEmail}`}>
              {site.contact.cooperationEmail}
            </a>.
          </p>
          <a class="button legal-contact-button" href={`mailto:${site.contact.cooperationEmail}`}>
            Email our team
          </a>
        </section>
      </article>
    </div>
  </section>
</BaseLayout>
